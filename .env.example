# Variables de entorno del proyecto.
#
# El prefijo PUBLIC_ es obligatorio para que Astro las exponga al código que
# corre en el navegador. Se leen en tiempo de BUILD, así que cambiarlas exige
# volver a construir.
#
# Copiar a .env y ajustar.

# Dominio público, con https y sin barra final. De aquí salen el canonical, el
# hreflang, el sitemap, robots.txt, llms.txt y los datos estructurados. Sin ella
# todo apunta a http://localhost:4321: imprescindible en producción.
PUBLIC_SITE_URL=https://dominio.es

# Giro de las láminas de vidrio del primer cuadro al pasar el puntero por
# encima. La hoja señalada se vuelve cinco grados hacia la cámara y vuelve sola
# al salir.
#
#   true (por defecto)  activo
#   false | 0 | off     apagado: no se registra ningún listener de puntero ni
#                       se construye el raycaster
#
# Con el sistema en «reducir movimiento» queda apagado en cualquier caso, y en
# táctil también: allí pointermove llega con el dedo ya apoyado y dejaría la
# hoja girada sin forma de deshacerlo.
PUBLIC_HERO_HOVER=true

# Versión en inglés del sitio (/en/). Cuando está apagada desaparece el selector
# de idioma de la barra, las páginas dejan de declarar hreflang y cada URL /en/
# redirige a su página en español. El español no cambia en ningún caso.
#
#   true (por defecto)  activo
#   false | 0 | off     apagado
PUBLIC_BILINGUE=true

# Web oculta: cada página muestra solo «NO DISPONIBLE». Para publicar el dominio
# (DNS, certificado) antes de la entrega.
#
#   false (por defecto)  la web se ve normal
#   true | 1 | on        todas las páginas muestran «NO DISPONIBLE»
PUBLIC_NO_DISPONIBLE=false

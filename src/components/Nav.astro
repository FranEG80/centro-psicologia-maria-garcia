---
import { centro, navegacion } from '../data/contenido.js';

/* La firma de la portada empieza grande en mitad de pantalla y aterriza en la
   barra. Para que no haya costura, el elemento que viaja es el mismo que se
   queda: no hay una firma grande y otra pequeña, hay una sola con transformada.

   El nombre se parte en dos, y la partición hace doble trabajo. Por encima de
   1080px el nombre completo arranca grande en dos líneas: la de arriba es el
   prefijo y la de abajo el núcleo, cada una con su transformada, y al aterrizar
   las dos valen cero y quedan en la misma línea de la barra. Nada se reflúe: el
   salto de línea es de mentira, son dos piezas colocadas.

   Por debajo de 1080px el prefijo no se maqueta y queda solo «María García»,
   que es lo que cabe en una barra de una línea. */
const nucleo = 'María García';
const prefijo = centro.nombre.endsWith(nucleo)
  ? centro.nombre.slice(0, centro.nombre.length - nucleo.length).trim()
  : '';
const letras = [...prefijo];

/* El recorrido de la firma solo existe donde existe el primer cuadro. En las
   páginas interiores la barra es barra desde el primer pintado. */
const portada = Astro.url.pathname.replace(/\/+$/, '') === '';
---

<header class:list={['nav', portada && 'nav--portada']} data-nav>
  <!--
    La capa de material va aparte del contenido y solo cambia de opacidad.
    Animar backdrop-filter o background-color obliga al navegador a recomponer
    en cada fotograma; una capa que solo cruza de 0 a 1 de opacidad se compone
    en GPU y no cuesta nada.
  -->
  <div class="nav__material vitrina" aria-hidden="true"></div>

  <div class="nav__barra">
    {/* A la portada, no a #top: con páginas interiores publicadas, un ancla
        que no existe fuera de la home deja la marca sin destino. */}
    <a class="nav__marca" href="/" data-nav-marca>
      {/* El monograma va en línea y no como <img>: durante el recorrido se
          escala 7x, y un SVG en línea se vuelve a rasterizar a la escala del
          fotograma mientras que una imagen se estira del mapa de 26 px. */}
      <span class="solo-lectores">{centro.nombre}</span>
      <svg
        class="nav__monograma"
        viewBox="72 24 382 305"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        data-nav-monograma
      >
        <path
          d="M229 60C181 62 125 91 103 137C77 190 92 247 136 282C178 315 264 327 327 309C354 301 364 282 357 259C354 249 349 240 344 233"
          stroke-width="6.5"></path>
        <path
          d="M229 60C296 45 371 57 408 98C438 131 443 161 422 179C405 194 374 202 342 208C318 213 299 212 286 208"
          stroke-width="6.5"></path>
        <path
          d="M188 295C208 237 215 145 231 38C219 112 216 188 222 230C226 260 236 255 244 220L258 153C260 145 263 147 264 161L268 199C270 218 277 228 286 211L302 178C307 167 311 168 314 181L318 205C321 222 329 223 336 207L345 187C349 179 354 185 356 196C359 210 368 215 382 211C397 207 412 201 426 194"
          stroke-width="7"></path>
      </svg>
      <span class="caps nav__nombre" aria-hidden="true">
        <span class="nav__prefijo" data-nav-prefijo>
          {
            letras.map((c, i) => (
              <span style={`--i:${i}`}>{c === ' ' ? ' ' : c}</span>
            ))
          }
        </span><span class="nav__nucleo" data-nav-nucleo>{nucleo}</span>
      </span>
    </a>

    <nav class="nav__enlaces" aria-label="Secciones">
      <ul>
        {
          navegacion.map((n) => (
            <li>
              <a class="caps nav__enlace" href={n.href}>
                {n.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav__derecha">
      <!--
        Aquí va el teléfono y no el WhatsApp. El rótulo "Escribir por WhatsApp"
        ya vive en el primer cuadro y en el cierre; una tercera aparición sería
        la misma intención repetida. Llamar es otra cosa, y en una consulta es
        el gesto de más valor.
      -->
      <a class="nav__telefono" href={`tel:${centro.telefonoTel}`}>
        {centro.telefono}
      </a>
      <button
        class="nav__conmutador"
        type="button"
        aria-expanded="false"
        aria-controls="nav-panel"
        data-nav-boton
      >
        <span class="solo-lectores">Abrir el menú</span>
        <span class="nav__trazos" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="nav__panel vitrina" id="nav-panel" hidden data-nav-panel>
    <ul>
      {
        navegacion.map((n) => (
          <li>
            <a class="nav__panel-enlace" href={n.href}>
              {n.texto}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="boton nav__panel-boton" href={centro.whatsapp} rel="noopener">
      Escribir por WhatsApp
    </a>
    <a class="nav__panel-tel" href={`tel:${centro.telefonoTel}`}>
      {centro.telefono}
    </a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-nav);
    isolation: isolate;
  }

  /* -- El material ------------------------------------------------------- */
  /* Sobre el primer cuadro no hay barra: el hormigón de la escena ya es el
     fondo, y meter un cristal delante de otro cristal es ruido. Al salir del
     cuadro la barra aparece como material. */
  .nav__material {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 1;
    transition: opacity var(--dur-material) var(--ease-hoja);
  }

  /* En la portada con JS el material no existe desde el primer pintado, no
     desde que arranca el script: entre una cosa y la otra hay tiempo de
     descargar three, y ahí se veía la barra entera antes de que la escena la
     retirase. Vuelve cuando el script pone la bandera. */
  html.js .nav--portada .nav__material {
    opacity: 0;
  }

  html.js :global(body.barra-montada) .nav--portada .nav__material {
    opacity: 1;
  }

  /* -- La barra ---------------------------------------------------------- */
  .nav__barra {
    height: 64px;
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--paso-2);
  }

  .nav__marca {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
    /* El texto mide 21 px de alto: sin esto el objetivo de pulsado se queda a
       menos de la mitad de los 44 px que pide WCAG 2.5.5. */
    min-height: 44px;
    text-decoration: none;
    color: var(--tinta);
    transition: transform var(--dur-pulsar) var(--ease-out);
  }

  .nav__marca:active {
    transform: scale(0.97);
  }

  .nav__monograma {
    width: 26px;
    height: auto;
    aspect-ratio: 382 / 305;
    flex: none;
    /* El punto fijo de la escala es el centro del trazo, no su esquina: así el
       monograma crece sobre sí mismo y el recorrido es una sola recta. */
    transform-origin: 50% 50%;
  }

  .nav__nombre {
    font-size: var(--t-micro);
    letter-spacing: 0.2em;
    text-indent: 0.2em;
    white-space: nowrap;
    color: inherit;
  }

  .nav__nucleo {
    display: inline-block;
    transform-origin: 50% 50%;
  }

  /* El prefijo ocupa su ancho desde el primer pintado aunque no se vea: si
     apareciera creando caja, el nombre ya aterrizado se desplazaría a la
     derecha y el aterrizaje acabaría en un salto. */
  .nav__prefijo {
    display: inline-block;
    white-space: pre;
    transform-origin: 50% 50%;
  }

  .nav__prefijo span {
    display: inline-block;
  }

  /* El nombre completo es largo y a 1080px envolvía a dos líneas, que en una
     barra de una sola línea se lee como un error. No se recorta el nombre
     real: por debajo de ese ancho solo queda el núcleo, y el completo sigue en
     el pie y para lectores de pantalla. */
  @media (max-width: 1080px) {
    .nav__prefijo {
      display: none;
    }
  }

  .nav__enlaces {
    justify-self: end;
    min-width: 0;
  }

  .nav__enlaces ul {
    display: flex;
    gap: clamp(1rem, 2.2vw, 2.25rem);
  }

  .nav__enlace {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    position: relative;
    font-size: var(--t-micro);
    letter-spacing: 0.18em;
    text-indent: 0.18em;
    white-space: nowrap;
    color: var(--tinta);
    text-decoration: none;
  }

  /* El subrayado se dibuja de izquierda a derecha, el mismo gesto de enlace de
     toda la página. */
  .nav__enlace::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0.18em;
    bottom: 0.9rem;
    height: 1px;
    background: currentColor;
    clip-path: inset(0 100% 0 0);
    transition: clip-path var(--dur-ui) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav__enlace:hover::after {
      clip-path: inset(0 0 0 0);
    }
  }

  .nav__enlace:focus-visible::after {
    clip-path: inset(0 0 0 0);
  }

  .nav__derecha {
    display: flex;
    align-items: center;
    gap: var(--paso-2);
  }

  .nav__telefono {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--t-micro);
    letter-spacing: 0.14em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--tinta);
    text-decoration: none;
    position: relative;
  }

  .nav__telefono::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.9rem;
    height: 1px;
    background: currentColor;
    clip-path: inset(0 100% 0 0);
    transition: clip-path var(--dur-ui) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav__telefono:hover::after {
      clip-path: inset(0 0 0 0);
    }
  }

  .nav__telefono:focus-visible::after {
    clip-path: inset(0 0 0 0);
  }

  /* -- Conmutador -------------------------------------------------------- */
  .nav__conmutador {
    display: none;
    width: 44px;
    height: 44px;
    place-items: center;
    color: var(--tinta);
    transition: transform var(--dur-pulsar) var(--ease-out);
  }

  .nav__conmutador:active {
    transform: scale(0.97);
  }

  .nav__trazos {
    display: grid;
    gap: 5px;
    width: 18px;
  }

  .nav__trazos i {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform var(--dur-ui) var(--ease-out);
  }

  .nav__conmutador[aria-expanded='true'] .nav__trazos i:first-child {
    transform: translateY(3px);
  }

  .nav__conmutador[aria-expanded='true'] .nav__trazos i:last-child {
    transform: translateY(-3px);
  }

  /* -- Panel ------------------------------------------------------------- */
  .nav__panel {
    padding: var(--paso-2) var(--gutter) var(--paso-3);
    display: grid;
    gap: var(--paso-2);
    justify-items: start;
    transform-origin: top center;
    animation: nav-hoja var(--dur-material) var(--ease-hoja) both;
  }

  /* Nada entra desde scale(0): un panel que sale de la nada no tiene masa. */
  @keyframes nav-hoja {
    from {
      opacity: 0;
      transform: translate3d(0, -8px, 0) scale(0.985);
    }
  }

  .nav__panel[hidden] {
    display: none;
  }

  .nav__panel ul {
    display: grid;
    gap: 0.15rem;
    width: 100%;
  }

  .nav__panel-enlace {
    display: flex;
    align-items: center;
    min-height: 48px;
    font-size: var(--t-lista);
    color: var(--tinta);
    text-decoration: none;
    border-bottom: 1px solid var(--filete);
  }

  .nav__panel-boton {
    margin-top: var(--paso-1);
  }

  .nav__panel-tel {
    font-size: var(--t-cuerpo);
    letter-spacing: 0.14em;
    font-variant-numeric: tabular-nums;
    color: var(--tinta-2);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  /* -- Sobre el primer cuadro -------------------------------------------- */
  /* Mientras la firma viaja por el centro de la pantalla, la barra no existe:
     ni enlaces, ni teléfono, ni conmutador. Entran los tres a la vez que el
     material, cuando la firma ya está en su sitio y a su tamaño. Se apagan con
     visibility además de opacidad para que el tabulador no encuentre destinos
     invisibles. */
  .nav__enlaces,
  .nav__telefono,
  .nav__conmutador {
    transition:
      opacity var(--dur-material) var(--ease-hoja),
      visibility 0s linear 0s,
      transform var(--dur-pulsar) var(--ease-out);
  }

  html.js .nav--portada .nav__enlaces,
  html.js .nav--portada .nav__telefono,
  html.js .nav--portada .nav__conmutador {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--dur-ui) var(--ease-out),
      visibility 0s linear var(--dur-ui);
  }

  html.js :global(body.barra-montada) .nav--portada .nav__enlaces,
  html.js :global(body.barra-montada) .nav--portada .nav__telefono,
  html.js :global(body.barra-montada) .nav--portada .nav__conmutador {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity var(--dur-material) var(--ease-hoja),
      visibility 0s linear 0s;
  }

  /* -- La firma en recorrido ---------------------------------------------- */
  /* Hasta que el script no ha medido la barra no se sabe dónde cae la firma
     grande. Pintarla antes es enseñar la marca en la esquina y arrancarla de
     ahí de un tirón. El plazo de gracia de la plantilla retira html.js si el
     script no llega, y entonces la marca vuelve a verse en su sitio. */
  html.js .nav--portada .nav__marca {
    opacity: 0;
  }

  html.js .nav--portada .nav__marca.esta-medida {
    opacity: 1;
  }

  @media (max-width: 900px) {
    .nav__barra {
      height: 56px;
      grid-template-columns: 1fr auto;
    }
    .nav__enlaces {
      display: none;
    }
    .nav__telefono {
      display: none;
    }
    .nav__conmutador {
      display: grid;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__material,
    .nav__enlace::after,
    .nav__telefono::after,
    .nav__trazos i {
      transition: none;
    }
    /* Con movimiento reducido no hay recorrido de firma: el script la deja
       aterrizada desde el principio, así que el prefijo se ve sin cascada. */
    html.js .nav--portada .nav__prefijo span {
      opacity: 1;
      transition: none;
      transition-delay: 0s;
    }
    .nav__panel {
      animation: none;
    }
    .nav__marca:active,
    .nav__conmutador:active {
      transform: none;
    }
  }
</style>

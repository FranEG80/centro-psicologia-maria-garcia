---
import { alternas, ariaCurrent, i18n, idiomas, ruta as rutaDe } from '../i18n/index.js';
import Boton from './Boton.astro';

const { lang, t, d, ruta } = i18n(Astro);
const { centro, navegacion } = d;

const nucleo = 'María García';
const prefijo = centro.nombre.endsWith(nucleo)
  ? centro.nombre.slice(0, centro.nombre.length - nucleo.length).trim()
  : '';
const letras = [...prefijo];

const sinBarra = (p) => p.replace(/\/+$/, '');
const portada = sinBarra(Astro.url.pathname) === sinBarra(ruta('inicio'));

// Enlace al otro idioma: a la misma página si existe allí; si no (páginas
// legales, solo en español), a su portada.
const otro = t.otroIdioma;
const hayOtroIdioma = idiomas.includes(otro.lang);
const destinoIdioma =
  alternas(Astro.url.pathname)?.[otro.lang] ?? rutaDe(otro.lang, 'inicio');

// Las dos banderas, siempre en el mismo orden: la del idioma actual no es
// enlace. Cada nombre va en su propio idioma, como el resto del selector.
const nombresIdioma = { es: 'Español', en: 'English' };
const opcionesIdioma = idiomas
  .filter((l) => l === lang || l === otro.lang)
  .map((l) => ({ lang: l, nombre: nombresIdioma[l] }));
---

<header class:list={['nav', portada && 'nav--portada']} data-nav>
  <div class="nav__material vitrina" aria-hidden="true"></div>

  <div class="nav__barra">
    <a class="nav__marca" href={ruta('inicio')} data-nav-marca>
      <span class="solo-lectores">{centro.nombre}</span>
      <svg
        class="nav__monograma"
        viewBox="72 24 382 305"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        data-nav-monograma
      >
        <path
          d="M229 60C181 62 125 91 103 137C77 190 92 247 136 282C178 315 264 327 327 309C354 301 364 282 357 259C354 249 349 240 344 233"
          stroke-width="6.5"></path>
        <path
          d="M229 60C296 45 371 57 408 98C438 131 443 161 422 179C405 194 374 202 342 208C318 213 299 212 286 208"
          stroke-width="6.5"></path>
        <path
          d="M188 295C208 237 215 145 231 38C219 112 216 188 222 230C226 260 236 255 244 220L258 153C260 145 263 147 264 161L268 199C270 218 277 228 286 211L302 178C307 167 311 168 314 181L318 205C321 222 329 223 336 207L345 187C349 179 354 185 356 196C359 210 368 215 382 211C397 207 412 201 426 194"
          stroke-width="7"></path>
      </svg>
      <span class="caps nav__nombre" aria-hidden="true">
        <span class="nav__prefijo" data-nav-prefijo>
          {
            letras.map((c, i) => (
              <span style={`--i:${i}`}>{c === ' ' ? ' ' : c}</span>
            ))
          }
        </span><span class="nav__nucleo" data-nav-nucleo>{nucleo}</span>
      </span>
    </a>

    <nav class="nav__enlaces" aria-label={t.nav.secciones}>
      <ul>
        {
          navegacion.map((n) => (
            <li>
              <a
                class="caps nav__enlace"
                href={n.href}
                aria-current={ariaCurrent(Astro.url.pathname, n.href)}
              >
                {n.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav__derecha">
      <a class="nav__telefono" href={`tel:${centro.telefonoTel}`}>
        {centro.telefono}
      </a>
      {
        hayOtroIdioma && (
          <ul class="nav__idiomas">
            {opcionesIdioma.map((o) => {
              const bandera =
                o.lang === 'es' ? (
                  <svg class="nav__bandera" viewBox="0 0 3 2" aria-hidden="true">
                    <rect width="3" height="2" fill="#AA151B" />
                    <rect y="0.5" width="3" height="1" fill="#F1BF00" />
                  </svg>
                ) : (
                  <svg class="nav__bandera" viewBox="7.5 0 45 30" aria-hidden="true">
                    <clipPath id="nav-bandera-gb-aspas">
                      <path d="M30,15h30v15zv15h-30zh-30v-15zv-15h30z" />
                    </clipPath>
                    <path d="M0,0v30h60v-30z" fill="#012169" />
                    <path d="M0,0L60,30M60,0L0,30" stroke="#FFF" stroke-width="6" />
                    <path
                      d="M0,0L60,30M60,0L0,30"
                      clip-path="url(#nav-bandera-gb-aspas)"
                      stroke="#C8102E"
                      stroke-width="4"
                    />
                    <path d="M30,0v30M0,15h60" stroke="#FFF" stroke-width="10" />
                    <path d="M30,0v30M0,15h60" stroke="#C8102E" stroke-width="6" />
                  </svg>
                );
              return (
                <li>
                  {o.lang === lang ? (
                    <span class="nav__idioma" lang={o.lang} aria-current="true">
                      {bandera}
                      <span class="solo-lectores">{o.nombre}</span>
                    </span>
                  ) : (
                    <a
                      class="nav__idioma"
                      href={destinoIdioma}
                      lang={o.lang}
                      hreflang={o.lang}
                      aria-label={otro.aria}
                    >
                      {bandera}
                    </a>
                  )}
                </li>
              );
            })}
          </ul>
        )
      }
      <button
        class="nav__conmutador"
        type="button"
        aria-expanded="false"
        aria-controls="nav-panel"
        data-nav-boton
        data-texto-abrir={t.nav.abrirMenu}
        data-texto-cerrar={t.nav.cerrarMenu}
      >
        <span class="solo-lectores">{t.nav.abrirMenu}</span>
        <span class="nav__trazos" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="nav__panel vitrina" id="nav-panel" hidden data-nav-panel>
    <nav aria-label={t.nav.secciones}>
      <ul>
        {
          navegacion.map((n) => (
            <li>
              <a
                class="nav__panel-enlace"
                href={n.href}
                aria-current={ariaCurrent(Astro.url.pathname, n.href)}
              >
                {n.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <Boton class="nav__panel-boton" href={centro.whatsapp} rel="noopener">
      WhatsApp
    </Boton>
    <a class="nav__panel-tel" href={`tel:${centro.telefonoTel}`}>
      {centro.telefono}
    </a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-nav);
    isolation: isolate;
  }

  .nav__material {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 1;
    transition: opacity var(--dur-material) var(--ease-hoja);
  }

  html.js .nav--portada .nav__material {
    opacity: 0;
  }

  html.js :global(body.barra-montada) .nav--portada .nav__material {
    opacity: 1;
  }

  .nav__barra {
    height: 64px;
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--paso-2);
  }

  /* Entre páginas la barra se queda quieta (transición de vista). En la portada
     el logo grande vive en ella: solo se nombra cuando ya está montada. */
  .nav:not(.nav--portada) .nav__barra,
  :global(body.barra-montada) .nav--portada .nav__barra {
    view-transition-name: nav-barra;
  }

  .nav__marca {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
    min-height: 44px;
    text-decoration: none;
    color: var(--tinta);
    transition: transform var(--dur-pulsar) var(--ease-out);
  }

  .nav__marca:active {
    transform: scale(0.97);
  }

  .nav__monograma {
    width: 38px;
    height: auto;
    aspect-ratio: 382 / 305;
    flex: none;
    transform-origin: 50% 50%;
  }

  .nav__nombre {
    font-size: var(--t-micro);
    letter-spacing: 0.2em;
    text-indent: 0.2em;
    white-space: nowrap;
    color: inherit;
  }

  .nav__nucleo {
    display: inline-block;
    transform-origin: 50% 50%;
  }

  .nav__prefijo {
    display: inline-block;
    white-space: pre;
    transform-origin: 50% 50%;
  }

  .nav__prefijo span {
    display: inline-block;
  }

  @media (max-width: 1080px) {
    .nav__prefijo {
      display: none;
    }
  }

  .nav__enlaces {
    justify-self: end;
    min-width: 0;
  }

  .nav__enlaces ul {
    display: flex;
    gap: clamp(1rem, 2.2vw, 2.25rem);
  }

  .nav__enlace {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    position: relative;
    font-size: var(--t-micro);
    letter-spacing: 0.18em;
    text-indent: 0.18em;
    white-space: nowrap;
    color: var(--tinta);
    text-decoration: none;
  }

  .nav__enlace::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0.18em;
    bottom: 0.9rem;
    height: 1px;
    background: currentColor;
    clip-path: inset(0 100% 0 0);
    transition: clip-path var(--dur-ui) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav__enlace:hover::after {
      clip-path: inset(0 0 0 0);
    }
  }

  .nav__enlace:focus-visible::after {
    clip-path: inset(0 0 0 0);
  }

  .nav__derecha {
    display: flex;
    align-items: center;
    gap: var(--paso-2);
  }

  .nav__telefono {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--t-micro);
    letter-spacing: 0.14em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--tinta);
    text-decoration: none;
    position: relative;
  }

  .nav__telefono::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.9rem;
    height: 1px;
    background: currentColor;
    clip-path: inset(0 100% 0 0);
    transition: clip-path var(--dur-ui) var(--ease-out);
  }

  .nav__idiomas {
    display: flex;
    margin-inline: -0.35rem;
  }

  /* Solo la bandera: el relleno da un área táctil razonable sin separarlas. */
  .nav__idioma {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.35rem;
  }

  .nav__bandera {
    display: block;
    width: 18px;
    height: 12px;
    border-radius: 1.5px;
    box-shadow: 0 0 0 1px var(--filete);
    transition:
      opacity var(--dur-ui) var(--ease-out),
      filter var(--dur-ui) var(--ease-out);
  }

  /* El idioma actual va a color pleno; el otro, apagado hasta que se apunta. */
  a.nav__idioma .nav__bandera {
    opacity: 0.45;
    filter: grayscale(0.6);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav__telefono:hover::after {
      clip-path: inset(0 0 0 0);
    }
    a.nav__idioma:hover .nav__bandera {
      opacity: 1;
      filter: none;
    }
  }

  .nav__telefono:focus-visible::after {
    clip-path: inset(0 0 0 0);
  }

  a.nav__idioma:focus-visible .nav__bandera {
    opacity: 1;
    filter: none;
  }

  .nav__conmutador {
    display: none;
    width: 44px;
    height: 44px;
    place-items: center;
    color: var(--tinta);
    transition: transform var(--dur-pulsar) var(--ease-out);
  }

  .nav__conmutador:active {
    transform: scale(0.97);
  }

  .nav__trazos {
    display: grid;
    gap: 5px;
    width: 18px;
  }

  .nav__trazos i {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform var(--dur-ui) var(--ease-out);
  }

  .nav__conmutador[aria-expanded='true'] .nav__trazos i:first-child {
    transform: translateY(3px);
  }

  .nav__conmutador[aria-expanded='true'] .nav__trazos i:last-child {
    transform: translateY(-3px);
  }

  .nav__panel {
    padding: var(--paso-2) var(--gutter) var(--paso-3);
    display: grid;
    gap: var(--paso-2);
    justify-items: start;
    transform-origin: top center;
    animation: nav-hoja var(--dur-material) var(--ease-hoja) both;
    /* Con ventana baja o zoom alto el panel no cabe: scroll propio, para
       que los últimos enlaces no queden fuera de alcance. */
    max-height: calc(100dvh - 4rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .nav__panel nav {
    width: 100%;
  }

  @keyframes nav-hoja {
    from {
      opacity: 0;
      transform: translate3d(0, -8px, 0) scale(0.985);
    }
  }

  .nav__panel[hidden] {
    display: none;
  }

  .nav__panel ul {
    display: grid;
    gap: 0.15rem;
    width: 100%;
  }

  .nav__panel-enlace {
    display: flex;
    align-items: center;
    min-height: 48px;
    font-size: var(--t-lista);
    color: var(--tinta);
    text-decoration: none;
    border-bottom: 1px solid var(--filete);
  }

  .nav__panel-boton {
    margin-top: var(--paso-1);
  }

  .nav__panel-tel {
    font-size: var(--t-cuerpo);
    letter-spacing: 0.14em;
    font-variant-numeric: tabular-nums;
    /* El panel es translúcido: sobre secciones oscuras, tinta-2 no llega a 4,5:1. */
    color: var(--tinta);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .nav__enlaces,
  .nav__telefono,
  .nav__idiomas,
  .nav__conmutador {
    transition:
      opacity var(--dur-material) var(--ease-hoja),
      visibility 0s linear 0s,
      transform var(--dur-pulsar) var(--ease-out);
  }

  html.js .nav--portada .nav__enlaces,
  html.js .nav--portada .nav__telefono,
  html.js .nav--portada .nav__idiomas,
  html.js .nav--portada .nav__conmutador {
    /* Solo opacity, sin visibility:hidden: con teclado y lectores de pantalla
       los enlaces siguen al alcance y, al recibir el foco, main.js lleva la
       escena a su último fotograma, donde la barra ya está montada. */
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-ui) var(--ease-out);
  }

  html.js :global(body.barra-montada) .nav--portada .nav__enlaces,
  html.js :global(body.barra-montada) .nav--portada .nav__telefono,
  html.js :global(body.barra-montada) .nav--portada .nav__idiomas,
  html.js :global(body.barra-montada) .nav--portada .nav__conmutador {
    opacity: 1;
    pointer-events: auto;
    transition: opacity var(--dur-material) var(--ease-hoja);
  }

  html.js .nav--portada .nav__marca {
    opacity: 0;
  }

  html.js .nav--portada .nav__marca.esta-medida {
    opacity: 1;
  }

  @media (max-width: 900px) {
    .nav__barra {
      height: 56px;
      grid-template-columns: 1fr auto;
    }
    .nav__enlaces {
      display: none;
    }
    .nav__telefono {
      display: none;
    }
    .nav__conmutador {
      display: grid;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__material,
    .nav__enlace::after,
    .nav__telefono::after,
    .nav__bandera,
    .nav__trazos i {
      transition: none;
    }
    html.js .nav--portada .nav__prefijo span {
      opacity: 1;
      transition: none;
      transition-delay: 0s;
    }
    .nav__panel {
      animation: none;
    }
    .nav__marca:active,
    .nav__conmutador:active {
      transform: none;
    }
  }
</style>

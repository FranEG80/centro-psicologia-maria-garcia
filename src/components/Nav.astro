---
import { centro, navegacion } from '../data/contenido.js';
import Boton from './Boton.astro';

const nucleo = 'María García';
const prefijo = centro.nombre.endsWith(nucleo)
  ? centro.nombre.slice(0, centro.nombre.length - nucleo.length).trim()
  : '';
const letras = [...prefijo];

const portada = Astro.url.pathname.replace(/\/+$/, '') === '';
---

<header class:list={['nav', portada && 'nav--portada']} data-nav>
  <div class="nav__material vitrina" aria-hidden="true"></div>

  <div class="nav__barra">
    <a class="nav__marca" href="/" data-nav-marca>
      <span class="solo-lectores">{centro.nombre}</span>
      <svg
        class="nav__monograma"
        viewBox="72 24 382 305"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        data-nav-monograma
      >
        <path
          d="M229 60C181 62 125 91 103 137C77 190 92 247 136 282C178 315 264 327 327 309C354 301 364 282 357 259C354 249 349 240 344 233"
          stroke-width="6.5"></path>
        <path
          d="M229 60C296 45 371 57 408 98C438 131 443 161 422 179C405 194 374 202 342 208C318 213 299 212 286 208"
          stroke-width="6.5"></path>
        <path
          d="M188 295C208 237 215 145 231 38C219 112 216 188 222 230C226 260 236 255 244 220L258 153C260 145 263 147 264 161L268 199C270 218 277 228 286 211L302 178C307 167 311 168 314 181L318 205C321 222 329 223 336 207L345 187C349 179 354 185 356 196C359 210 368 215 382 211C397 207 412 201 426 194"
          stroke-width="7"></path>
      </svg>
      <span class="caps nav__nombre" aria-hidden="true">
        <span class="nav__prefijo" data-nav-prefijo>
          {
            letras.map((c, i) => (
              <span style={`--i:${i}`}>{c === ' ' ? ' ' : c}</span>
            ))
          }
        </span><span class="nav__nucleo" data-nav-nucleo>{nucleo}</span>
      </span>
    </a>

    <nav class="nav__enlaces" aria-label="Secciones">
      <ul>
        {
          navegacion.map((n) => (
            <li>
              <a class="caps nav__enlace" href={n.href}>
                {n.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav__derecha">
      <a class="nav__telefono" href={`tel:${centro.telefonoTel}`}>
        {centro.telefono}
      </a>
      <button
        class="nav__conmutador"
        type="button"
        aria-expanded="false"
        aria-controls="nav-panel"
        data-nav-boton
      >
        <span class="solo-lectores">Abrir el menú</span>
        <span class="nav__trazos" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="nav__panel vitrina" id="nav-panel" hidden data-nav-panel>
    <ul>
      {
        navegacion.map((n) => (
          <li>
            <a class="nav__panel-enlace" href={n.href}>
              {n.texto}
            </a>
          </li>
        ))
      }
    </ul>
    <Boton class="nav__panel-boton" href={centro.whatsapp} rel="noopener">
      WhatsApp
    </Boton>
    <a class="nav__panel-tel" href={`tel:${centro.telefonoTel}`}>
      {centro.telefono}
    </a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-nav);
    isolation: isolate;
  }

  .nav__material {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 1;
    transition: opacity var(--dur-material) var(--ease-hoja);
  }

  html.js .nav--portada .nav__material {
    opacity: 0;
  }

  html.js :global(body.barra-montada) .nav--portada .nav__material {
    opacity: 1;
  }

  .nav__barra {
    height: 64px;
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--paso-2);
  }

  .nav__marca {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
    min-height: 44px;
    text-decoration: none;
    color: var(--tinta);
    transition: transform var(--dur-pulsar) var(--ease-out);
  }

  .nav__marca:active {
    transform: scale(0.97);
  }

  .nav__monograma {
    width: 26px;
    height: auto;
    aspect-ratio: 382 / 305;
    flex: none;
    transform-origin: 50% 50%;
  }

  .nav__nombre {
    font-size: var(--t-micro);
    letter-spacing: 0.2em;
    text-indent: 0.2em;
    white-space: nowrap;
    color: inherit;
  }

  .nav__nucleo {
    display: inline-block;
    transform-origin: 50% 50%;
  }

  .nav__prefijo {
    display: inline-block;
    white-space: pre;
    transform-origin: 50% 50%;
  }

  .nav__prefijo span {
    display: inline-block;
  }

  @media (max-width: 1080px) {
    .nav__prefijo {
      display: none;
    }
  }

  .nav__enlaces {
    justify-self: end;
    min-width: 0;
  }

  .nav__enlaces ul {
    display: flex;
    gap: clamp(1rem, 2.2vw, 2.25rem);
  }

  .nav__enlace {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    position: relative;
    font-size: var(--t-micro);
    letter-spacing: 0.18em;
    text-indent: 0.18em;
    white-space: nowrap;
    color: var(--tinta);
    text-decoration: none;
  }

  .nav__enlace::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0.18em;
    bottom: 0.9rem;
    height: 1px;
    background: currentColor;
    clip-path: inset(0 100% 0 0);
    transition: clip-path var(--dur-ui) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav__enlace:hover::after {
      clip-path: inset(0 0 0 0);
    }
  }

  .nav__enlace:focus-visible::after {
    clip-path: inset(0 0 0 0);
  }

  .nav__derecha {
    display: flex;
    align-items: center;
    gap: var(--paso-2);
  }

  .nav__telefono {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--t-micro);
    letter-spacing: 0.14em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--tinta);
    text-decoration: none;
    position: relative;
  }

  .nav__telefono::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.9rem;
    height: 1px;
    background: currentColor;
    clip-path: inset(0 100% 0 0);
    transition: clip-path var(--dur-ui) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav__telefono:hover::after {
      clip-path: inset(0 0 0 0);
    }
  }

  .nav__telefono:focus-visible::after {
    clip-path: inset(0 0 0 0);
  }

  .nav__conmutador {
    display: none;
    width: 44px;
    height: 44px;
    place-items: center;
    color: var(--tinta);
    transition: transform var(--dur-pulsar) var(--ease-out);
  }

  .nav__conmutador:active {
    transform: scale(0.97);
  }

  .nav__trazos {
    display: grid;
    gap: 5px;
    width: 18px;
  }

  .nav__trazos i {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform var(--dur-ui) var(--ease-out);
  }

  .nav__conmutador[aria-expanded='true'] .nav__trazos i:first-child {
    transform: translateY(3px);
  }

  .nav__conmutador[aria-expanded='true'] .nav__trazos i:last-child {
    transform: translateY(-3px);
  }

  .nav__panel {
    padding: var(--paso-2) var(--gutter) var(--paso-3);
    display: grid;
    gap: var(--paso-2);
    justify-items: start;
    transform-origin: top center;
    animation: nav-hoja var(--dur-material) var(--ease-hoja) both;
  }

  @keyframes nav-hoja {
    from {
      opacity: 0;
      transform: translate3d(0, -8px, 0) scale(0.985);
    }
  }

  .nav__panel[hidden] {
    display: none;
  }

  .nav__panel ul {
    display: grid;
    gap: 0.15rem;
    width: 100%;
  }

  .nav__panel-enlace {
    display: flex;
    align-items: center;
    min-height: 48px;
    font-size: var(--t-lista);
    color: var(--tinta);
    text-decoration: none;
    border-bottom: 1px solid var(--filete);
  }

  .nav__panel-boton {
    margin-top: var(--paso-1);
  }

  .nav__panel-tel {
    font-size: var(--t-cuerpo);
    letter-spacing: 0.14em;
    font-variant-numeric: tabular-nums;
    color: var(--tinta-2);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .nav__enlaces,
  .nav__telefono,
  .nav__conmutador {
    transition:
      opacity var(--dur-material) var(--ease-hoja),
      visibility 0s linear 0s,
      transform var(--dur-pulsar) var(--ease-out);
  }

  html.js .nav--portada .nav__enlaces,
  html.js .nav--portada .nav__telefono,
  html.js .nav--portada .nav__conmutador {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--dur-ui) var(--ease-out),
      visibility 0s linear var(--dur-ui);
  }

  html.js :global(body.barra-montada) .nav--portada .nav__enlaces,
  html.js :global(body.barra-montada) .nav--portada .nav__telefono,
  html.js :global(body.barra-montada) .nav--portada .nav__conmutador {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity var(--dur-material) var(--ease-hoja),
      visibility 0s linear 0s;
  }

  html.js .nav--portada .nav__marca {
    opacity: 0;
  }

  html.js .nav--portada .nav__marca.esta-medida {
    opacity: 1;
  }

  @media (max-width: 900px) {
    .nav__barra {
      height: 56px;
      grid-template-columns: 1fr auto;
    }
    .nav__enlaces {
      display: none;
    }
    .nav__telefono {
      display: none;
    }
    .nav__conmutador {
      display: grid;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__material,
    .nav__enlace::after,
    .nav__telefono::after,
    .nav__trazos i {
      transition: none;
    }
    html.js .nav--portada .nav__prefijo span {
      opacity: 1;
      transition: none;
      transition-delay: 0s;
    }
    .nav__panel {
      animation: none;
    }
    .nav__marca:active,
    .nav__conmutador:active {
      transform: none;
    }
  }
</style>

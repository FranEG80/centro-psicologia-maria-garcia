---
import { centro, navegacion, areas } from '../data/contenido.js';
import Boton from './Boton.astro';

const anio = new Date().getFullYear();

const { lat, lon } = centro.coordenadas;
const mapaEmbebido = `https://maps.google.com/maps?q=${lat},${lon}&z=16&hl=es&output=embed`;

---

<footer class="pie">
  <section class="cierre" aria-labelledby="cierre-titulo">
    <hr class="canto" />
    <div class="envoltura cierre__caja">
      <div class="cierre__texto">
        <h2 class="cierre__titulo" id="cierre-titulo">Escríbeme y lo vemos</h2>
        <p class="cierre__plomo">
          Llama o escríbeme y lo vemos. Te contestaré en un máximo de 24 horas.
        </p>
      </div>

      <div class="cierre__acciones">
        <Boton
          class="cierre__boton"
          variant="claro"
          href={centro.whatsapp}
          rel="noopener noreferrer"
          target="_blank"
        >
          WhatsApp
        </Boton>
        <a class="cierre__tel" href={`tel:${centro.telefonoTel}`}>
          {centro.telefono}
        </a>
        <p class="cierre__horario">{centro.direccion}, {centro.localidad}</p>
      </div>
    </div>
  </section>

  <div class="pie__fondo">
    <hr class="canto" />

    <div class="envoltura pie__reticula">
      <div class="pie__cabecera">
        <div class="pie__marca">
          <img
            class="pie__monograma"
            src="/media/logo-maria-garcia-crema.svg"
            alt=""
            width="382"
            height="305"
            aria-hidden="true"
            decoding="async"
          />
          <p class="pie__nombre">{centro.nombre}</p>
        </div>

        <dl class="pie__registros">
          {
            centro.credenciales.map((c) => (
              <div class="pie__registro">
                <dt class="pie__etiqueta">{c.etiqueta}</dt>
                <dd class="pie__valor">{c.valor}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <nav class="pie__bloque" aria-label="Páginas">
        <h2 class="caps pie__epigrafe">Páginas</h2>
        <ul class="pie__lista">
          {
            navegacion.map((n) => (
              <li>
                <a class="pie__enlace" href={n.href}>
                  {n.texto}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="pie__bloque" aria-label="Áreas de atención">
        <h2 class="caps pie__epigrafe">Áreas</h2>
        <ul class="pie__lista">
          {
            areas.map((a) => (
              <li>
                <a class="pie__enlace" href={`/areas/${a.id}`}>
                  {a.titulo}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="pie__bloque pie__bloque--contacto">
        <h2 class="caps pie__epigrafe">Contacto</h2>
        <ul class="pie__lista">
          <li>
            <a class="pie__enlace" href={`tel:${centro.telefonoTel}`}>
              {centro.telefono}
            </a>
          </li>
          <li>
            <a
              class="pie__enlace"
              href={centro.whatsapp}
              rel="noopener noreferrer"
              target="_blank"
            >
              WhatsApp
            </a>
          </li>
          <li>
            <a class="pie__enlace" href={`mailto:${centro.email}`}>
              {centro.email}
            </a>
          </li>
        </ul>

        <h2 class="caps pie__epigrafe pie__epigrafe--sitio">Dónde estamos</h2>
        <address class="pie__direccion">
          {centro.direccion}<br />
          {centro.cp} {centro.localidad}, {centro.provincia}
        </address>
        <a
          class="pie__enlace pie__mapa"
          href={centro.mapa}
          rel="noopener noreferrer"
          target="_blank"
        >
          Cómo llegar
          <span class="solo-lectores"> (se abre en una pestaña nueva)</span>
        </a>
      </div>

      <div class="pie__bloque pie__bloque--mapa">
        <div
          class="pie__lienzo"
          data-tercero="mapa"
          data-tercero-src={mapaEmbebido}
          data-tercero-titulo={`Mapa con la ubicación del centro en ${centro.direccion}, ${centro.localidad}`}
        >
          <div class="marco" data-tercero-aviso>
            <img
              class="marco__plano"
              src="/media/mapa-previo.webp"
              alt=""
              aria-hidden="true"
              width="760"
              height="470"
              decoding="async"
            />
            <div class="marco__contenido">
              <p class="caps marco__epigrafe">Mapa de Google</p>
              <p class="marco__texto">
                Este mapa lo sirve Google y deja cookies suyas en tu navegador.
                No se carga hasta que lo autorices.
              </p>
              <Boton class="marco__boton" variant="claro" data-tercero-cargar>
                Cargar el mapa
              </Boton>
              <a
                class="pie__enlace marco__alterna"
                href={centro.mapa}
                rel="noopener noreferrer"
                target="_blank"
              >
                O abrirlo en Google Maps
                <span class="solo-lectores"> (se abre en una pestaña nueva)</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <hr class="pie__filete" />

      <div class="pie__cola">
        <p class="pie__legal">
          © {anio} {centro.profesional}. Todos los derechos reservados.
        </p>
        <nav class="pie__legales" aria-label="Información legal">
          <a class="pie__enlace" href="/aviso-legal">Aviso legal</a>
          <a class="pie__enlace" href="/privacidad">Protección de datos</a>
          <a class="pie__enlace" href="/cookies">Cookies</a>
          <button class="pie__enlace pie__preferencias" type="button" data-consentimiento-abrir>
            Preferencias de cookies
          </button>
        </nav>
      </div>
    </div>
  </div>
</footer>

<style>
  .cierre {
    background: var(--petroleo);
    color: var(--crema);
  }

  .cierre__caja {
    padding-block: var(--paso-5);
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--paso-3) var(--paso-4);
    align-items: center;
  }

  .cierre__titulo {
    font-size: var(--t-h2);
    font-weight: 300;
    line-height: 1.14;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-indent: 0.06em;
    max-width: 16ch;
    text-wrap: balance;
  }

  .cierre__plomo {
    margin-top: var(--paso-2);
    max-width: 42ch;
    color: var(--campo-tinta-2);
    text-wrap: pretty;
  }

  .cierre__acciones {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--paso-2);
  }

  .cierre__boton {
    width: 100%;
    max-width: 22rem;
  }

  .cierre__horario {
    font-size: var(--t-micro-2);
    color: var(--campo-tinta-2);
  }

  .cierre__tel {
    font-size: var(--t-cuerpo-lg);
    font-weight: 300;
    letter-spacing: 0.06em;
    color: var(--crema);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    border-bottom: 1px solid
      color-mix(in srgb, var(--crema) 40%, transparent);
    padding-bottom: 0.15em;
    transition: border-color var(--dur-ui) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .cierre__tel:hover {
      border-color: var(--crema);
    }
  }

  .pie__fondo {
    background: var(--carbon);
    color: var(--crema);
  }

  .pie__reticula {
    padding-block: var(--paso-4) var(--paso-3);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--paso-3) var(--paso-2);
    align-items: start;
  }

  .pie__cabecera {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--paso-2) var(--paso-4);
    align-items: center;
    padding-bottom: var(--paso-3);
    border-bottom: 1px solid color-mix(in srgb, var(--topo) 26%, transparent);
  }

  .pie__marca {
    display: flex;
    align-items: center;
    gap: var(--paso-2);
  }

  .pie__monograma {
    width: clamp(2.75rem, 4vw, 3.5rem);
    height: auto;
    opacity: 0.9;
    flex: none;
  }

  .pie__nombre {
    font-size: var(--t-micro-2);
    font-weight: 300;
    line-height: 1.35;
    max-width: 16ch;
  }

  .pie__bloque {
    grid-column: span 2;
  }

  .pie__bloque--contacto {
    grid-column: span 3;
  }

  .pie__bloque--mapa {
    grid-column: span 5;
  }

  .pie__epigrafe--sitio {
    margin-top: var(--paso-3);
  }

  .pie__lienzo {
    width: 100%;
    height: 19rem;
    border: 1px solid color-mix(in srgb, var(--topo) 34%, transparent);
    display: block;
    position: relative;
  }

  .pie__lienzo :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .marco {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--paso-2);
    background: var(--carbon);
    overflow: hidden;
  }

  .marco[hidden] {
    display: none;
  }

  .marco__plano {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    mix-blend-mode: screen;
  }

  .marco::after {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--petroleo) 34%, transparent);
  }

  .marco__contenido {
    position: relative;
    z-index: 1;
    align-self: flex-start;
    max-width: 24rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--paso-1);
    padding: var(--paso-2);
    background: color-mix(in srgb, var(--carbon) 86%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid color-mix(in srgb, var(--topo) 26%, transparent);
  }

  .marco__epigrafe {
    color: var(--topo);
  }

  .marco__texto {
    font-size: var(--t-micro-2);
    line-height: 1.6;
    max-width: 32ch;
    color: var(--crema);
    text-wrap: pretty;
  }

  .marco__boton {
    margin-top: var(--paso-1);
  }

  .marco__alterna {
    border-bottom-color: color-mix(in srgb, var(--topo) 60%, transparent);
  }

  .marco__licencia {
    position: absolute;
    z-index: 1;
    right: var(--paso-2);
    top: var(--paso-1);
    font-size: var(--t-micro);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--topo);
  }

  @media (max-width: 480px) {
    .marco__licencia {
      position: static;
      margin-top: var(--paso-2);
      align-self: flex-start;
    }
  }

  .pie__epigrafe {
    color: var(--topo);
    margin-bottom: var(--paso-1);
  }

  .pie__lista {
    display: grid;
    gap: 0.35rem;
  }

  .pie__enlace {
    display: inline-block;
    min-height: 1.5rem;
    color: var(--crema);
    font-size: var(--t-micro-2);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-ui) ease, color var(--dur-ui) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .pie__enlace:hover {
      border-color: var(--canto);
      color: var(--canto);
    }
  }

  .pie__enlace:focus-visible {
    outline-color: var(--canto);
    outline-offset: 4px;
  }

  .pie__preferencias {
    background: none;
    border: 0;
    border-bottom: 1px solid transparent;
    padding: 0;
    font: inherit;
    font-size: var(--t-micro-2);
    text-align: left;
    cursor: pointer;
  }

  .pie__direccion {
    font-style: normal;
    font-size: var(--t-micro-2);
    line-height: 1.65;
    color: var(--crema);
  }

  .pie__mapa {
    margin-top: var(--paso-1);
    border-bottom-color: color-mix(in srgb, var(--topo) 60%, transparent);
  }

  .pie__registros {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--paso-1) var(--paso-3);
  }

  .pie__registro {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }

  .pie__etiqueta {
    font-size: var(--t-micro);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--topo);
  }

  .pie__valor {
    font-size: var(--t-micro-2);
    color: var(--crema);
    font-variant-numeric: tabular-nums;
  }

  .pie__filete {
    grid-column: 1 / -1;
    height: 1px;
    border: 0;
    margin: var(--paso-1) 0 0;
    background: color-mix(in srgb, var(--topo) 26%, transparent);
  }

  .pie__cola {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--paso-1) var(--paso-3);
  }

  .pie__legal {
    font-size: var(--t-micro);
    color: var(--topo);
    margin: 0;
  }

  .pie__legales {
    display: flex;
    flex-wrap: wrap;
    gap: var(--paso-1) var(--paso-3);
  }

  @media (max-width: 860px) {
    .cierre__caja {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
    .cierre__boton {
      max-width: none;
    }
  }

  @media (max-width: 1100px) {
    .pie__bloque {
      grid-column: span 4;
    }
    .pie__bloque--contacto {
      grid-column: span 4;
    }
    .pie__bloque--mapa {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 680px) {
    .pie__bloque,
    .pie__bloque--contacto,
    .pie__bloque--mapa {
      grid-column: 1 / -1;
    }
    .pie__cabecera {
      grid-template-columns: minmax(0, 1fr);
    }
    .pie__registros {
      flex-direction: column;
      justify-content: flex-start;
      gap: var(--paso-1);
    }
  }
</style>

---
// Iconos de línea (1px, sin relleno, currentColor) de cada área. Sin instrumentos de evaluación.
// Todo trazo es un <path pathLength="1">: se dibuja cuando su [data-revelar] recibe .es-visible.
const { id } = Astro.props;
---

<svg
  viewBox="0 0 32 32"
  width="40"
  height="40"
  fill="none"
  stroke="currentColor"
  stroke-width="1"
  aria-hidden="true"
  focusable="false"
>
  {
    id === 'adultos' && (
      <>
        <path pathLength="1" d="M3 22h26" />
        <path pathLength="1" d="M10 22a6 6 0 0 1 12 0" />
        <path pathLength="1" d="M16 13V10M9.64 15.64 7.51 13.51M22.36 15.64l2.13-2.13" />
        <path pathLength="1" d="M11 26h10" />
      </>
    )
  }
  {
    id === 'infancia' && (
      <>
        <path pathLength="1" d="M9 27h14" />
        <path pathLength="1" d="M16 27V15" />
        <path pathLength="1" d="M16 19C9 19 6 15 6 9c7 0 10 4 10 10z" />
        <path pathLength="1" d="M16 15c0-5 3-8 9-8 0 6-3 8-9 8z" />
      </>
    )
  }
  {
    id === 'escolares' && (
      <>
        <path pathLength="1" d="M16 8C13 6 8 6 4 7v17c4-1 9-1 12 1 3-2 8-2 12-1V7c-4-1-9-1-12 1z" />
        <path pathLength="1" d="M16 8v17" />
        <path pathLength="1" d="M8 12h5M8 16h5M19 12h5M19 16h5" />
      </>
    )
  }
  {
    id === 'familia' && (
      <>
        <path pathLength="1" d="M11 8a8 8 0 1 0 0 16a8 8 0 1 0 0-16" />
        <path pathLength="1" d="M21 8a8 8 0 1 1 0 16a8 8 0 1 1 0-16" />
      </>
    )
  }
  {
    id === 'neuropsicologia' && (
      <>
        <path pathLength="1" d="M16 13a3 3 0 1 1 0 6a3 3 0 1 1 0-6" />
        <path pathLength="1" d="M13.74 14.03 9.5 10.32M18.12 13.88 22.59 9.41M13.63 17.84 8.58 21.77M18.24 17.99 23.51 22.67" />
        <path pathLength="1" d="M8 7a2 2 0 1 1 0 4a2 2 0 1 1 0-4" />
        <path pathLength="1" d="M24 6a2 2 0 1 1 0 4a2 2 0 1 1 0-4" />
        <path pathLength="1" d="M7 21a2 2 0 1 1 0 4a2 2 0 1 1 0-4" />
        <path pathLength="1" d="M25 22a2 2 0 1 1 0 4a2 2 0 1 1 0-4" />
      </>
    )
  }
  {
    id === 'juridica' && (
      <>
        <path pathLength="1" d="M16 5v21M11 26h10" />
        <path pathLength="1" d="M7 9h18" />
        <path pathLength="1" d="M7 9l-3 9M7 9l3 9M4 18h6a3 3 0 0 1-6 0" />
        <path pathLength="1" d="M25 9l-3 9M25 9l3 9M22 18h6a3 3 0 0 1-6 0" />
      </>
    )
  }
  {
    id === 'forense' && (
      <>
        <path pathLength="1" d="M22 15V9l-5-5H6v24h8" />
        <path pathLength="1" d="M17 4v5h5" />
        <path pathLength="1" d="M10 12h5M10 16h4M10 20h3" />
        <path pathLength="1" d="M21 15a6 6 0 1 1 0 12a6 6 0 1 1 0-12" />
        <path pathLength="1" d="M25.5 25.5 29 29" />
      </>
    )
  }
</svg>

<style>
  svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Guion 1.2 y no 1: Chrome acorta el guion en arcos pequeños y dejaba los círculos abiertos. */
  path {
    stroke-dasharray: 1.2 2;
  }

  path:nth-child(2) { --trazo: 1; }
  path:nth-child(3) { --trazo: 2; }
  path:nth-child(4) { --trazo: 3; }
  path:nth-child(5) { --trazo: 4; }
  path:nth-child(6) { --trazo: 5; }

  :global(html.js [data-revelar]) path {
    stroke-dashoffset: 1.2;
  }

  :global(html.js [data-revelar].es-visible) path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 900ms var(--ease-in-out);
    transition-delay: calc(
      var(--revelar-retardo, 0ms) + 80ms + var(--trazo, 0) * 140ms
    );
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js [data-revelar]) path,
    :global(html.js [data-revelar].es-visible) path {
      stroke-dashoffset: 0;
      transition: none;
    }
  }
</style>

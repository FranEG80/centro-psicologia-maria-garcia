---
import { centro, navegacion } from '../data/contenido.js';
const anio = new Date().getFullYear();
---

<footer class="pie">
  <hr class="canto pie__canto" />

  <div class="envoltura pie__reticula">
    <div class="pie__marca">
      <img
        class="pie__monograma"
        src="/media/logo-maria-garcia-crema.svg"
        alt=""
        width="382"
        height="305"
        aria-hidden="true"
        decoding="async"
      />
      <p class="pie__nombre">{centro.nombre}</p>
    </div>

    <nav class="pie__nav" aria-label="Secciones, pie de página">
      <ul>
        {
          navegacion.map((n) => (
            <li>
              <a href={n.href}>{n.texto}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <dl class="pie__registros">
      {
        centro.credenciales.map((c) => (
          <div class="pie__registro">
            <dt class="pie__etiqueta">{c.etiqueta}</dt>
            <dd class="pie__valor">{c.valor}</dd>
          </div>
        ))
      }
    </dl>

    <hr class="canto pie__cierre" />

    <p class="pie__legal">
      © {anio} {centro.profesional}. {centro.direccion}, {centro.cp}{' '}
      {centro.localidad}, {centro.provincia}.
    </p>
  </div>
</footer>

<style>
  .pie {
    background-color: var(--carbon);
    background-image: linear-gradient(
      to bottom,
      var(--campo),
      var(--carbon) 140px
    );
    background-repeat: no-repeat;
    color: var(--lino);
  }

  .pie__reticula {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--paso-2);
    row-gap: var(--paso-2);
    align-items: start;
    padding-block: var(--paso-6) var(--paso-4);
  }

  .pie__marca {
    grid-column: 1 / span 4;
    display: grid;
    gap: var(--paso-2);
    justify-items: start;
  }

  .pie__monograma {
    width: clamp(7rem, 12vw, 10rem);
    height: auto;
  }

  .pie__nombre {
    font-size: var(--t-micro-2);
    font-weight: 450;
    line-height: 1.7;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-indent: 0.2em;
    text-wrap: pretty;
    max-width: 22ch;
    color: var(--lino);
  }

  .pie__nav {
    grid-column: 6 / span 3;
  }

  .pie__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block: 0.25rem;
    font-size: var(--t-lista);
    color: var(--lino);
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.22em;
    transition: color var(--dur-ui) ease, text-decoration-color var(--dur-ui) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .pie__nav a:hover {
      color: var(--crema);
      text-decoration-color: color-mix(in srgb, var(--lino) 60%, transparent);
    }
  }

  .pie__nav a:focus-visible {
    color: var(--crema);
    outline-color: var(--lino);
  }

  .pie__nav a:active {
    transform: scale(0.97);
  }

  .pie__registros {
    grid-column: 9 / span 4;
    display: grid;
    gap: var(--paso-2);
  }

  .pie__registro {
    display: grid;
    gap: 0.15rem;
  }

  .pie__etiqueta {
    font-size: var(--t-micro);
    font-weight: 450;
    line-height: 1.5;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-wrap: pretty;
    overflow-wrap: break-word;
    max-width: 28ch;
    color: color-mix(in srgb, var(--lino) 84%, var(--carbon));
  }

  .pie__valor {
    font-size: var(--t-cuerpo);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    overflow-wrap: break-word;
    color: var(--crema);
  }

  .pie__cierre {
    grid-column: 1 / -1;
    margin-top: var(--paso-5);
    opacity: 0.34;
  }

  .pie__legal {
    grid-column: 1 / -1;
    font-size: var(--t-micro);
    line-height: 1.6;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    text-wrap: pretty;
    max-width: 60ch;
    color: color-mix(in srgb, var(--lino) 84%, var(--carbon));
  }

  @media (max-width: 900px) {
    .pie__reticula {
      row-gap: var(--paso-3);
    }
    .pie__marca,
    .pie__nav,
    .pie__registros {
      grid-column: 1 / -1;
    }
    .pie__cierre {
      margin-top: var(--paso-4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pie__nav a {
      transition: none;
    }
    .pie__nav a:active {
      transform: none;
    }
  }
</style>

---
import { centro, formacion, perfil } from '../data/contenido.js';
import Boton from './Boton.astro';
---

<section class="profesional" aria-labelledby="profesional-titulo">
  <div class="envoltura">
    <div class="profesional__cabecera">
      <div class="profesional__presentacion">
        <p class="caps profesional__marca">Quién atiende</p>
        <h2 class="h2 profesional__titulo" id="profesional-titulo">
          Una misma profesional, todo el recorrido
        </h2>
      </div>

      <figure class="profesional__figura">
        <div class="profesional__marco" aria-hidden="true"></div>
        <figcaption class="caps caps--contenido profesional__pie">
          {perfil.apertura}
        </figcaption>
      </figure>

      <blockquote class="profesional__compromiso">
        <p>{perfil.compromiso.join(' ')}</p>
        <footer class="profesional__firma">
          <cite>{centro.profesional}</cite>
        </footer>
      </blockquote>
    </div>

    <div class="profesional__datos">

      <div class="profesional__trayectoria">
        <p class="cuerpo">{perfil.trayectoria}</p>
        <Boton class="profesional__boton" href="/sobre-mi">Sobre mí</Boton>
      </div>

      <div class="profesional__formacion">
        <h3 class="caps profesional__epigrafe">Formación</h3>
        <ul class="profesional__lista">
          {formacion.map((f) => <li>{f}</li>)}
        </ul>
      </div>

    </div>
  </div>
</section>

<style>
  .profesional {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--hormigon);
    border-top: 1px solid var(--canto);
    padding-block: var(--paso-6);
  }

  .profesional::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: url('/media/tex/wall.webp');
    background-size: 900px auto;
    opacity: 0.4;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .profesional__cabecera {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-areas:
      'figura presentacion'
      'figura compromiso';
    column-gap: var(--paso-4);
    align-items: start;
  }

  .profesional__presentacion {
    grid-area: presentacion;
  }

  .profesional__marca {
    color: var(--tinta-2);
  }

  .profesional__titulo {
    margin-top: var(--paso-1);
    max-width: 22ch;
  }

  .profesional__compromiso {
    grid-area: compromiso;
    margin-top: var(--paso-3);
    max-width: 47ch;
    color: var(--tinta);
    font-size: clamp(1.25rem, 1.45vw, 1.5rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .profesional__compromiso p::before {
    content: '«';
  }

  .profesional__compromiso p::after {
    content: '»';
  }

  .profesional__firma {
    text-align: right;
    margin-top: var(--paso);
    color: var(--tinta-2);
    font-size: var(--t-lista);
    font-style: normal;
    font-weight: 550;
  }

  .profesional__firma cite {
    font-style: inherit;
  }

  .profesional__figura {
    grid-area: figura;
    min-width: 0;
    background: var(--crema);
    padding: var(--paso-2);
    box-shadow: var(--sombra-baja);
  }

  .profesional__marco {
    width: 100%;
    aspect-ratio: 1.42;
    border: 1px solid var(--filete);
    background: var(--crema);
  }

  .profesional__pie {
    margin-top: var(--paso-2);
    color: var(--tinta-2);
    text-wrap: pretty;
  }

  .profesional__datos {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--paso-4);
    margin-top: var(--paso-3);
  }

  .profesional__trayectoria {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--paso-3);
    color: var(--tinta-2);
  }

  .profesional__epigrafe {
    color: var(--tinta-2);
    margin-bottom: var(--paso-2);
  }

  .profesional__lista {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--paso-3);
  }

  .profesional__lista li {
    padding-block: var(--paso-1);
    border-top: 1px solid var(--filete);
    font-size: var(--t-lista);
    line-height: 1.45;
    text-wrap: pretty;
  }

  @media (max-width: 800px) {
    .profesional__cabecera {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'presentacion'
        'figura'
        'compromiso';
    }

    .profesional__figura {
      margin-top: var(--paso-3);
    }

    .profesional__datos {
      grid-template-columns: minmax(0, 1fr);
    }

    .profesional__marco {
      aspect-ratio: 1.3;
    }

    .profesional__lista {
      grid-template-columns: minmax(0, 1fr);
    }

    .profesional__trayectoria {
      gap: var(--paso-2);
    }
  }
</style>

---
import { Image } from 'astro:assets';

import { areas } from '../data/contenido.js';
import luz from '../assets/luz.webp';

const NAV = '64px';
---

<section class="areas seccion" id="areas" data-areas>
  <div class="areas__banda" aria-hidden="true">
    <Image
      src={luz}
      widths={[640, 960, 1280]}
      sizes="100vw"
      alt=""
      loading="eager"
      fetchpriority="low"
      decoding="async"
    />
  </div>

  <hr class="canto areas__filo" />

  <div class="envoltura">
    <div class="areas__reticula">
      <div class="areas__portico">
        <h2 class="h2 areas__titulo">Áreas de valoración e intervención</h2>
      </div>

      <nav class="areas__indice" aria-label="Áreas de valoración e intervención">
        <ul class="areas__lista">
          {
            areas.map((a) => (
              <li class="areas__item">
                <a
                  class="areas__enlace"
                  href={`#${a.id}`}
                  data-areas-enlace={a.id}
                >
                  <span class="areas__etiqueta">{a.titulo}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="areas__panel">
        {
          areas.map((a) => (
            <article class="areas__bloque" id={a.id} data-areas-bloque>
              <h3 class="h3 areas__nombre">{a.titulo}</h3>
              <p class="areas__sumario">{a.sumario}</p>
              <hr class="canto areas__corte" />
              <ul class="areas__puntos">
                {a.puntos.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style define:vars={{ nav: NAV }}>
  .areas {
    --areas-tinte: 0.03;
  }

  .areas::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--petroleo);
    opacity: calc(var(--areas-tinte) * 0.5);
    pointer-events: none;
  }

  .areas__banda {
    position: relative;
    margin-bottom: 0;
  }

  .areas__banda img {
    width: 100%;
    height: clamp(11rem, 24vh, 18rem);
    object-fit: cover;
    object-position: center 58%;
  }

  .areas__filo {
    position: relative;
    margin-bottom: var(--paso-4);
  }

  .envoltura {
    position: relative;
  }

  .areas__reticula {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--paso-2);
    row-gap: var(--paso-4);
    align-items: start;
  }

  .areas__portico {
    grid-column: 1 / span 5;
    grid-row: 1;
  }

  .areas__titulo {
    max-width: 20ch;
  }

  .areas__indice {
    grid-column: 1 / span 3;
    grid-row: 2;
    position: sticky;
    top: calc(var(--nav) + var(--paso-2));
  }

  .areas__lista {
    display: grid;
  }

  .areas__enlace {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-block: 0.35rem;
    color: var(--tinta-2);
    font-size: var(--t-lista);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.005em;
    text-decoration: none;
    text-wrap: pretty;
    overflow-wrap: break-word;
    transition: transform var(--dur-pulsar) var(--ease-out);
  }

  .areas__etiqueta {
    position: relative;
  }

  .areas__etiqueta::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.34em;
    height: 1px;
    background: linear-gradient(
      90deg,
      var(--canto-fuerte),
      color-mix(in srgb, var(--canto) 45%, transparent)
    );
    clip-path: inset(0 100% 0 0);
    transition: clip-path 260ms var(--ease-out);
    pointer-events: none;
  }

  .areas__enlace.esta-activo {
    color: var(--tinta);
    font-weight: 500;
  }

  .areas__enlace.esta-activo .areas__etiqueta::after {
    clip-path: inset(0 0 0 0);
  }

  @media (hover: hover) and (pointer: fine) {
    .areas__enlace:hover {
      color: var(--tinta);
    }
  }

  .areas__enlace:focus-visible {
    color: var(--tinta);
    outline-offset: 4px;
  }

  .areas__enlace:active {
    transform: scale(0.97);
  }

  .areas__panel {
    grid-column: 5 / -1;
    grid-row: 2;
    display: grid;
    gap: var(--paso-5);
    font-variant-numeric: tabular-nums;
  }

  .areas__bloque {
    scroll-margin-top: calc(var(--nav) + var(--paso-3));
  }

  .areas__nombre {
    max-width: 24ch;
  }

  .areas__sumario {
    margin-top: var(--paso-1);
    font-size: var(--t-cuerpo);
    color: var(--tinta-2);
    max-width: 58ch;
    text-wrap: pretty;
  }

  .areas__corte {
    margin-block: var(--paso-3) var(--paso-2);
  }

  .areas__puntos {
    columns: 2;
    column-gap: var(--paso-3);
    font-size: var(--t-lista);
    color: var(--tinta);
  }

  .areas__puntos li {
    break-inside: avoid;
    position: relative;
    padding-left: 1.5em;
    margin-bottom: 0.7rem;
    line-height: 1.5;
    max-width: 42ch;
    text-wrap: pretty;
    overflow-wrap: break-word;
  }

  .areas__puntos li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.74em;
    width: 0.75em;
    height: 1px;
    background: var(--acento);
  }

  @media (max-width: 1024px) {
    .areas__puntos {
      columns: 1;
    }
  }

  @media (max-width: 900px) {
    .areas__portico,
    .areas__indice,
    .areas__panel {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .areas__indice {
      position: static;
      top: auto;
    }

    .areas__lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--paso-2);
    }

    .areas__panel {
      gap: var(--paso-4);
    }

    .areas__titulo {
      max-width: 26ch;
    }
  }

  @media (max-width: 420px) {
    .areas__enlace {
      font-size: var(--t-micro-2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .areas__enlace {
      transition: none;
    }
    .areas__enlace:active {
      transform: none;
    }
    .areas__etiqueta::after {
      transition: none;
    }
  }
</style>

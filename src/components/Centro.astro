---
import { Image } from 'astro:assets';

import { centro, galeria } from '../data/contenido.js';

const [fachada, ...interiores] = galeria;

const reparto = [
  { trozo: 5, hilera: 'alta', col: 0, foco: '50% 45%' },
  { trozo: 3, hilera: 'alta', col: 1, foco: '50% 40%' },
  { trozo: 4, hilera: 'alta', col: 2, foco: '50% 45%' },
  { trozo: 3, hilera: 'baja', col: 0, foco: '50% 42%' },
  { trozo: 5, hilera: 'baja', col: 1, foco: '50% 45%' },
  { trozo: 4, hilera: 'baja', col: 2, foco: '50% 55%' },
];
const diagonal = (p, i) => (p.col + (p.hilera === 'baja' ? 1 : 0)) * 50 + (i === 0 ? 0 : 0);

const ANCHOS_PLACA = [320, 480, 640, 765];
const SIZES_PLACA = {
  3: '(max-width: 560px) 46vw, (max-width: 900px) 31vw, (max-width: 84rem) 23vw, 336px',
  4: '(max-width: 560px) 46vw, (max-width: 900px) 61vw, (max-width: 84rem) 31vw, 448px',
  5: '(max-width: 560px) 46vw, (max-width: 900px) 46vw, (max-width: 84rem) 39vw, 560px',
};
---

<section class="centro seccion" id="centro">
  <hr class="canto" />

  <div class="envoltura centro__cabecera" data-revelar-grupo>
    <h2 class="h2 centro__titulo" data-revelar>El centro</h2>
    <p class="cuerpo cuerpo--2 centro__entrada" data-revelar>
      {centro.direccion}, {centro.cp} {centro.localidad}. Fachada de granito
      negro, recepción, sala de espera, despachos de consulta, sala juvenil y
      zona infantil.
    </p>
  </div>

  <figure class="centro__fachada" data-centro-fachada>
    <div class="centro__fachada-marco">
      <Image
        src={fachada.src}
        widths={[640, 960, 1280, 1360]}
        sizes="100vw"
        alt={fachada.alt}
        loading="lazy"
        decoding="async"
        data-revelar="lamina"
        data-centro-fachada-img
      />
    </div>
    <figcaption class="envoltura">{fachada.pie}</figcaption>
  </figure>

  <div class="envoltura">
    <div class="centro__bloque" data-centro-bloque>
      {
        interiores.map((f, i) => {
          const p = reparto[i] ?? reparto[reparto.length - 1];
          return (
            <figure
              class="centro__plato"
              data-trozo={p.trozo}
              data-hilera={p.hilera}
            >
              <Image
                src={f.src}
                widths={ANCHOS_PLACA}
                sizes={SIZES_PLACA[p.trozo]}
                alt={f.alt}
                loading="lazy"
                decoding="async"
                data-revelar="lamina"
                style={`--revelar-retardo:${diagonal(p, i)}ms;object-position:${p.foco}`}
              />
              <figcaption>{f.pie}</figcaption>
            </figure>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .centro {
    overflow-x: clip;
  }

  .centro__cabecera {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--paso-2);
    row-gap: var(--paso-2);
    align-items: end;
    margin-block: var(--paso-4) var(--paso-3);
  }

  .centro__titulo {
    grid-column: 1 / span 5;
    max-width: 12ch;
  }

  .centro__entrada {
    grid-column: 6 / span 7;
    max-width: 52ch;
  }

  .centro__fachada {
    margin: 0 0 var(--paso-3);
  }

  .centro__fachada-marco {
    overflow: hidden;
    height: clamp(14rem, 40vh, 26rem);
  }

  .centro__fachada img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 54%;
    transform-origin: center;
    will-change: transform;
  }

  .centro__fachada figcaption {
    margin-top: 0.6rem;
    font-size: var(--t-micro-2);
    color: var(--tinta-2);
    text-align: right;
    text-wrap: pretty;
  }

  .centro__bloque {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 1px;
    row-gap: var(--paso-2);
  }

  .centro__plato {
    margin: 0;
    min-width: 0;
  }

  .centro__plato[data-trozo='3'] {
    grid-column: span 3;
  }
  .centro__plato[data-trozo='4'] {
    grid-column: span 4;
  }
  .centro__plato[data-trozo='5'] {
    grid-column: span 5;
  }

  .centro__plato img {
    display: block;
    width: 100%;
    object-fit: cover;
  }

  .centro__plato[data-hilera='alta'] img {
    height: clamp(15rem, 38vh, 27rem);
  }

  .centro__plato[data-hilera='baja'] img {
    height: clamp(12rem, 30vh, 21rem);
  }

  .centro__plato figcaption {
    margin-top: 0.6rem;
    padding-right: var(--paso-1);
    font-size: var(--t-micro-2);
    line-height: 1.45;
    color: var(--tinta-2);
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .centro__cabecera {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .centro__titulo,
    .centro__entrada {
      grid-column: 1;
    }

    .centro__bloque {
      grid-template-columns: repeat(6, 1fr);
    }
    .centro__plato[data-trozo='3'] {
      grid-column: span 2;
    }
    .centro__plato[data-trozo='4'] {
      grid-column: span 4;
    }
    .centro__plato[data-trozo='5'] {
      grid-column: span 3;
    }
    .centro__plato[data-hilera='alta'] img {
      height: clamp(12rem, 30vw, 18rem);
    }
    .centro__plato[data-hilera='baja'] img {
      height: clamp(10rem, 26vw, 15rem);
    }
  }

  @media (max-width: 560px) {
    .centro__bloque {
      grid-template-columns: repeat(2, 1fr);
    }
    .centro__plato[data-trozo='3'],
    .centro__plato[data-trozo='4'],
    .centro__plato[data-trozo='5'] {
      grid-column: span 1;
    }
    .centro__plato[data-hilera='alta'] img,
    .centro__plato[data-hilera='baja'] img {
      height: clamp(11rem, 42vw, 15rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .centro__fachada img {
      will-change: auto;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const marco = document.querySelector('[data-centro-fachada]');
  const img = document.querySelector('[data-centro-fachada-img]');

  if (!reducido && marco && img) {
    const ctx = gsap.context(() => {
      gsap.fromTo(
        img,
        { scale: 1 },
        {
          scale: 1.04,
          ease: 'none',
          scrollTrigger: {
            trigger: marco,
            start: 'top bottom',
            end: 'bottom top',
            scrub: true,
          },
        }
      );
    });
    window.addEventListener('pagehide', () => ctx.revert(), { once: true });
  }
</script>

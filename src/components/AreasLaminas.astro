---
import { i18n } from '../i18n/index.js';

const { id = 'areas' } = Astro.props;
const { t, d, ruta } = i18n(Astro);
const { areas } = d;
---

<section class="laminas" id={id} aria-labelledby={`${id}-titulo`}>
  <div class="laminas__poro" aria-hidden="true"></div>

  <div class="envoltura laminas__cabecera">
    <p class="caps laminas__marca">{t.inicio.areasMarca}</p>
    <h2 class="h2 laminas__titulo" id={`${id}-titulo`}>
      {t.inicio.areasTitulo}
    </h2>
  </div>

  <ul class="laminas__filas" data-revelar-grupo>
    {
      areas.map((a) => (
        <li class="laminas__fila" data-revelar>
          <a class="hoja" href={ruta('area', a.id)}>
            <span class="hoja__relleno" aria-hidden="true" />
            <span class="hoja__linea">
              <span class="hoja__nombre" data-titulo-viaja>{a.titulo}</span>
              {/* <span class="hoja__nota">{resumenAreas[a.id] ?? a.sumario}</span> */}
              <span class="hoja__flecha" aria-hidden="true">
                <svg viewBox="0 0 24 10" width="24" height="10" fill="none">
                  <path
                    d="M0 5h22M18 1l4 4-4 4"
                    stroke="currentColor"
                    stroke-width="1"
                  />
                </svg>
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .laminas {
    position: relative;
    isolation: isolate;
    background: var(--hormigon);
    border-top: 1px solid var(--canto);
    padding-block: var(--paso-5) var(--paso-5);
  }

  .laminas__poro {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: url('/media/tex/wall.webp');
    background-size: 900px auto;
    opacity: 0.45;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .laminas__cabecera {
    margin-bottom: var(--paso-4);
  }

  .laminas__marca {
    color: var(--tinta-2);
  }

  .laminas__titulo {
    margin-top: var(--paso-1);
    color: var(--carbon);
  }

  .laminas__filas {
    border-top: 1px solid var(--filete);
    border-bottom: 1px solid var(--filete);
  }

  .laminas__fila + .laminas__fila {
    border-top: 1px solid var(--filete);
  }

  .hoja {
    position: relative;
    isolation: isolate;
    display: block;
    width: 100%;
    color: var(--carbon);
    text-decoration: none;
    transition: color var(--dur-ui) ease;
  }

  .hoja__linea {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 3rem;
    align-items: center;
    gap: var(--paso-2);
    width: 100%;
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: var(--gutter);
    min-height: 6.5rem;
  }

  .hoja__relleno {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--vidrio-hoja);
    clip-path: inset(100% 0 0 0);
    transition: clip-path var(--dur-material) var(--ease-hoja);
  }

  .hoja__relleno::after {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: var(--canto);
    opacity: 0;
    transition: opacity var(--dur-ui) ease;
  }

  .hoja__nombre {
    font-size: var(--t-h3);
    font-weight: 300;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1.2;
    text-wrap: balance;
  }

  .hoja__nota {
    font-size: var(--t-lista);
    line-height: 1.5;
    color: var(--tinta-2);
    text-wrap: pretty;
    transition: color var(--dur-ui) ease;
  }

  .hoja__flecha {
    justify-self: end;
    color: var(--topo);
    opacity: 0;
    translate: -0.75rem 0;
    transition: opacity var(--dur-ui) ease,
      translate var(--dur-ui) var(--ease-out), color var(--dur-ui) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .hoja:hover .hoja__relleno {
      clip-path: inset(0 0 0 0);
    }
    .hoja:hover .hoja__relleno::after {
      opacity: 1;
    }
    .hoja:hover .hoja__nota {
      color: var(--tinta-hoja);
    }
    .hoja:hover .hoja__flecha {
      opacity: 1;
      translate: 0 0;
      color: var(--petroleo-800);
    }
  }

  .hoja:focus-visible {
    outline-offset: -3px;
  }
  .hoja:focus-visible .hoja__relleno {
    clip-path: inset(0 0 0 0);
  }
  .hoja:focus-visible .hoja__relleno::after {
    opacity: 1;
  }
  .hoja:focus-visible .hoja__nota {
    color: var(--tinta-hoja);
  }
  .hoja:focus-visible .hoja__flecha {
    opacity: 1;
    translate: 0 0;
    color: var(--petroleo-800);
  }

  @media (max-width: 1100px) {
    .hoja__linea {
      grid-template-columns: minmax(0, 1fr) 2.5rem;
      row-gap: var(--paso-1);
      padding-block: var(--paso-2);
    }
    .hoja__nota {
      grid-column: 1 / 2;
    }
  }

  @media (max-width: 560px) {
    .hoja__linea {
      grid-template-columns: minmax(0, 1fr);
      min-height: 5.5rem;
    }
    .hoja__flecha {
      display: none;
    }
    .hoja__nota {
      font-size: var(--t-micro-2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hoja,
    .hoja__relleno,
    .hoja__relleno::after,
    .hoja__nota,
    .hoja__flecha {
      transition-duration: 1ms;
    }
    .hoja__flecha {
      translate: 0 0;
    }
  }
</style>

---
import { centro, formacion, trayectoria } from '../data/contenido.js';
---

<section
  class="sobre seccion"
  id="sobre-mi"
  aria-labelledby="sobre-titulo"
  data-sobre
  data-revelar-grupo
>
  <hr class="canto sobre__canto" />

  <div class="envoltura">
    <div class="sobre__reticula">
      <div class="sobre__retrato" data-revelar aria-hidden="true">
        <div class="sobre__marco"></div>
      </div>

      <div class="sobre__texto">
        <div class="sobre__intro">
          <h2 class="h2" id="sobre-titulo" data-revelar>Sobre mí</h2>
          <p class="plomo sobre__entrada" data-revelar>
            Soy psicóloga sanitaria y mediadora familiar. Atiendo en consulta
            privada en {centro.localidad} ofreciendo servicios desde {centro.desde}, con niños,
            adolescentes, adultos, parejas y familias.
          </p>
        </div>

        <div class="sobre__creditos">
          <section class="sobre__bloque" data-revelar>
            <h3 class="h3">Formación</h3>
            <ul class="sobre__lista">
              {formacion.map((linea) => <li>{linea}</li>)}
            </ul>
          </section>

          <hr class="canto sobre__corte" />

          <section class="sobre__bloque" data-revelar>
            <h3 class="h3">Trayectoria</h3>
            <ul class="sobre__lista">
              {trayectoria.map((linea) => <li>{linea}</li>)}
            </ul>
          </section>
        </div>

        <dl class="sobre__registros" data-revelar>
          {
            centro.credenciales.map((registro) => (
              <div class="sobre__registro">
                <dt>{registro.etiqueta}</dt>
                <dd>{registro.valor}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .sobre__canto {
    margin-bottom: var(--paso-4);
  }

  .sobre__reticula {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--paso-2);
    row-gap: var(--paso-4);
    align-items: start;
  }

  .sobre__retrato {
    grid-column: 1 / span 5;
  }

  .sobre__marco {
    aspect-ratio: 3 / 4;
    background: var(--lino);
    border: 1px solid var(--filete);
  }

  .sobre__texto {
    grid-column: 7 / -1;
    display: grid;
    gap: var(--paso-3);
    align-content: start;
  }

  .sobre__intro {
    display: grid;
    gap: var(--paso-2);
  }

  .sobre__entrada {
    max-width: 58ch;
    text-wrap: pretty;
  }

  .sobre__creditos {
    display: grid;
    gap: var(--paso-3);
  }

  .sobre__corte {
    margin: 0;
  }

  .sobre__bloque {
    display: grid;
    gap: var(--paso-2);
  }

  .sobre__lista {
    display: grid;
    gap: var(--paso-2);
    font-size: var(--t-lista);
    line-height: 1.55;
    color: var(--tinta);
    max-width: 62ch;
  }

  .sobre__lista li {
    text-wrap: pretty;
    overflow-wrap: break-word;
  }

  .sobre__registros {
    margin: var(--paso-2) 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: auto auto;
    column-gap: var(--paso-2);
  }

  .sobre__registro {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    align-content: start;
  }

  .sobre__registro dt {
    font-size: var(--t-micro);
    font-weight: 450;
    line-height: 1.45;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tinta-2);
    text-wrap: pretty;
    overflow-wrap: break-word;
  }

  .sobre__registro dd {
    margin: var(--paso-1) 0 0;
    align-self: start;
    font-size: var(--t-cuerpo);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.03em;
    color: var(--tinta);
  }

  @media (max-width: 900px) {
    .sobre__reticula {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--paso-3);
    }
    .sobre__retrato {
      grid-column: 1;
      max-width: 24rem;
    }
    .sobre__texto {
      grid-column: 1;
    }
    .sobre__registros {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      row-gap: var(--paso-2);
    }
    .sobre__registro {
      display: block;
      grid-row: auto;
    }
  }

</style>

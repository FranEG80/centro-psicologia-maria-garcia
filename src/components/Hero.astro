---
import { i18n, whatsapp } from '../i18n/index.js';
import Boton from './Boton.astro';

const { t, d, ruta } = i18n(Astro);
const { areasHero, centro } = d;

const credencial = (id) => centro.credenciales.find((c) => c.id === id).valor;
const etiqueta = t.hero.registros;

const registros = [
  `${etiqueta.colegiada} ${credencial('colegiada')}`,
  // El valor viene como «nº 631» / «no. 631»; aquí solo el número.
  `${etiqueta.mediadora} ${credencial('mediadora').replace(/^(nº|no\.)\s*/, '')}`,
  `${etiqueta.nica} ${credencial('nica')}`,
  `${etiqueta.desde} ${centro.desde}`,
];
---

<section class="hero" id="top" data-hero>
  <div class="hero__escenario" data-hero-escenario>
    <div class="hero__ambiente" data-hero-ambiente aria-hidden="true"></div>

    <canvas class="hero__lienzo" data-hero-canvas aria-hidden="true"></canvas>

    <div class="hero__velo" aria-hidden="true"></div>

    <div class="hero__copia" data-hero-copia>
      <p class="caps caps--ancho hero__antetitulo">
        {t.hero.antetitulo} · {centro.localidad}, {centro.provincia}
      </p>

      <h1 class="hero__titulo">{t.hero.titulo[0]}<br />{t.hero.titulo[1]}</h1>

      <ul class="hero__areas" role="list" aria-label={t.hero.areasAria}>
        {
          areasHero.map((a) => (
            <li>
              <a href={ruta('area', a.id)}>{a.titulo}</a>
            </li>
          ))
        }
      </ul>

      <div class="hero__acciones">
        <Boton class="hero__boton" variant="claro" href={whatsapp(centro.whatsapp, t.whatsapp.general)} rel="noopener">
          WhatsApp
        </Boton>
        <a class="hero__telefono" href={`tel:${centro.telefonoTel}`}>
          {centro.telefono}
        </a>
      </div>

      <ul class="hero__registros" role="list">
        {registros.map((r) => <li>{r}</li>)}
      </ul>
    </div>
  </div>

  <div class="hero__flecha" data-hero-flecha aria-hidden="true">
    <svg viewBox="0 0 22 30" fill="none" stroke="currentColor" stroke-width="1.4">
      <path d="M11 1V27" stroke-linecap="round"></path>
      <path d="M3 20L11 28L19 20" stroke-linecap="round" stroke-linejoin="round"
      ></path>
    </svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
  }

  .hero__escenario {
    position: relative;
    height: 100dvh;
    min-height: 34rem;
    overflow: hidden;
    background: var(--crema);
    display: grid;
    grid-template-rows: 65fr 35fr;
  }

  .hero__ambiente,
  .hero__lienzo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__ambiente {
    z-index: 3;
    background: var(--crema);
    opacity: 1;
    transition: opacity 460ms var(--ease-out);
  }

  /* Mismo degradado que el primer fotograma de la escena (vista a través del
     vidrio central), para que al aparecer el lienzo apenas cambie la imagen. */
  html.js .hero__ambiente {
    background: linear-gradient(
      180deg,
      #28779e 0%,
      #28779e 40%,
      #3a80a2 52%,
      #4a88a9 62%,
      #5ea2c8 68%,
      #88b8d3 92%,
      #96c1d7 100%
    );
  }

  html.js .hero__ambiente.es-hormigon {
    background: var(--crema);
  }

  .hero__ambiente.esta-oculto {
    opacity: 0;
  }

  .hero__lienzo {
    z-index: 1;
    opacity: 1;
    transform: scale(var(--hero-esmerilado-zoom, 1));
  }

  .hero__lienzo.esta-esmerilado {
    filter: blur(var(--hero-esmerilado, 0px)) saturate(1.05);
    will-change: filter;
  }

  .hero__flecha {
    position: fixed;
    left: 50%;
    bottom: clamp(0.75rem, 2.4vh, 1.75rem);
    z-index: 4;
    width: 22px;
    margin-left: -11px;
    color: var(--carbon);
    pointer-events: none;
    transition: opacity 420ms var(--ease-out);
  }

  .hero__flecha.esta-oculta {
    opacity: 0;
  }

  .hero__flecha svg {
    display: block;
    width: 100%;
    height: auto;
    animation: hero-rebote 2s var(--ease-in-out) infinite;
  }

  @keyframes hero-rebote {
    0%,
    100% {
      transform: translate3d(0, -3px, 0);
    }
    50% {
      transform: translate3d(0, 4px, 0);
    }
  }

  .hero__velo {
    position: absolute;
    inset: auto 0 0;
    height: 62%;
    z-index: 2;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--crema) 0%, transparent) 0%,
      color-mix(in srgb, var(--crema) 22%, transparent) 45%,
      color-mix(in srgb, var(--crema) 56%, transparent) 100%
    );
  }

  .hero__copia {
    position: relative;
    z-index: 4;
    grid-row: 2;
    align-self: center;
    display: grid;
    justify-items: center;
    gap: clamp(1rem, 2vh, 1.75rem);
    text-align: center;
    padding: 0 var(--gutter) clamp(1.5rem, 4vh, 3rem);
    max-width: var(--maxw);
    margin-inline: auto;
    width: 100%;
    will-change: opacity, transform;
  }

  html.js .hero__copia {
    opacity: 0;
  }

  .hero__antetitulo {
    color: var(--tinta);
    margin: 0;
  }

  .hero__titulo {
    font-size: var(--t-h1);
    font-weight: 300;
    line-height: 1.16;
    letter-spacing: var(--track-h1);
    text-indent: var(--track-h1);
    text-transform: uppercase;
    color: var(--carbon);
    margin: 0;
    max-width: 22ch;
  }

  .hero__areas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.15rem 0.85rem;
    font-size: 1rem;
    font-weight: 450;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tinta);
    max-width: 74rem;
  }

  /* Enlaces a cada área con el mismo aspecto que el texto: solo cambia el
     cursor (el del enlace) y el foco con teclado (el global). */
  .hero__areas a {
    color: inherit;
    text-decoration: none;
  }

  .hero__areas li + li::before {
    content: '·';
    /* Separador decorativo: sin texto alternativo, el lector no lo anuncia
       entre enlace y enlace. */
    content: '·' / '';
    display: inline-block;
    margin-right: 0.85rem;
    color: var(--piedra);
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    margin-top: clamp(0.25rem, 1.5vh, 1rem);
  }

  .hero__boton {
    --boton-tinta: var(--carbon);
    --boton-borde: var(--filete-fuerte);
  }
  .hero__boton::before {
    background: var(--carbon);
  }
  /* Es variante «claro» (texto carbón al enfocar) pero con relleno carbón:
     sin esto, con teclado el texto quedaba carbón sobre carbón. */
  .hero__boton:focus-visible {
    color: var(--crema);
    border-color: var(--carbon);
  }
  @media (hover: hover) and (pointer: fine) {
    .hero__boton:hover {
      color: var(--crema);
      border-color: var(--carbon);
    }
  }

  .hero__telefono {
    color: var(--carbon);
    text-decoration: none;
    font-size: var(--t-cuerpo);
    letter-spacing: 0.2em;
    font-variant-numeric: tabular-nums;
    padding: 0.5rem 0;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-ui) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__telefono:hover {
      border-bottom-color: var(--carbon);
    }
  }

  .hero__registros {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.1rem 0.75rem;
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tinta-2);
    max-width: 72rem;
    line-height: 1.8;
  }

  .hero__registros li + li::before {
    content: '·';
    display: inline-block;
    margin-right: 0.75rem;
    color: var(--topo);
  }

  @media (max-width: 700px) {
    .hero__escenario {
      grid-template-rows: 52fr 48fr;
    }
    .hero__registros {
      letter-spacing: 0.1em;
    }
  }

  /* A 320 px (móviles pequeños o zoom del 400 %) el bloque ocupaba ~655 px y
     la escena mide 100dvh o 34rem como mínimo: se cortaba por abajo. Tipografía
     y tracking más ajustados bajan el bloque a ~446 px sin quitar contenido. */
  @media (max-width: 359px) {
    .hero__copia {
      gap: 0.75rem;
      padding-bottom: 1rem;
    }
    .hero__antetitulo {
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      text-indent: 0.1em;
    }
    .hero__titulo {
      font-size: 1.3125rem;
      letter-spacing: 0.05em;
      text-indent: 0.05em;
    }
    .hero__areas {
      font-size: 0.8125rem;
      letter-spacing: 0.06em;
      gap: 0.1rem 0.6rem;
    }
    .hero__areas li + li::before {
      margin-right: 0.6rem;
    }
    .hero__registros {
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      line-height: 1.5;
    }
    /* El bloque ocupa casi toda la escena y cruza los paneles de cristal
       (carbón sobre azul: ~3:1). Un velo crema más alto y más denso lleva el
       texto por encima de 5:1 sin ocultar la escena. */
    .hero__velo {
      height: 82%;
      background: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--crema) 0%, transparent) 0%,
        color-mix(in srgb, var(--crema) 40%, transparent) 14%,
        color-mix(in srgb, var(--crema) 66%, transparent) 100%
      );
    }
  }

  @media (max-height: 620px) and (min-width: 701px) {
    .hero__escenario {
      grid-template-rows: 55fr 45fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__flecha svg {
      animation: none;
    }
    .hero__flecha,
    .hero__ambiente,
    .hero__lienzo {
      transition: none;
    }
  }
</style>

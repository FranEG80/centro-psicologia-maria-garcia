---
import { areasHero, centro } from '../data/contenido.js';

/* Los rótulos del primer cuadro son los cortos de la referencia. Los completos
   viven en «Sobre mí» y en el pie, donde hay sitio para leerlos. */
const registros = [
  `Nº colegiada ${centro.credenciales[0].valor}`,
  `Mediadora familiar ${centro.credenciales[1].valor.replace('nº ', '')}`,
  `NICA ${centro.credenciales[2].valor}`,
  `Desde ${centro.desde}`,
];
---

<section class="hero" id="top" data-hero>
  <div class="hero__escenario" data-hero-escenario>
    <!--
      Sustituto del primer fotograma. Antes había aquí un póster de 94 K con la
      escena renderizada, pero mostraba el plano final abierto mientras el
      lienzo arranca en un macro azul: el cambio saltaba de plano general a
      primer plano. Y además competía por el ancho de banda con three.js.

      A p=0 el cuadro es un campo de azul transmitido homogéneo, así que un
      gradiente lo imita exacto por 0 bytes. Los tres tonos son el compuesto
      medido: crema del muro iluminado por el factor de multiplicación de la
      lámina central a la altura de la cámara.
    -->
    <div class="hero__ambiente" data-hero-ambiente aria-hidden="true"></div>

    <canvas class="hero__lienzo" data-hero-canvas aria-hidden="true"></canvas>

    <!-- Seguro de contraste sobre el tercio inferior. Invisible sobre el
         hormigón; garantiza el 4.5:1 si el fotograma se oscurece. -->
    <div class="hero__velo" aria-hidden="true"></div>

    <div class="hero__copia" data-hero-copia>
      <p class="caps caps--ancho hero__antetitulo">
        Psicología · {centro.localidad}, {centro.provincia}
      </p>

      <h1 class="hero__titulo">Lo mismo, visto<br />con luz suficiente</h1>

      <ul class="hero__areas" role="list">
        {areasHero.map((a) => <li>{a}</li>)}
      </ul>

      <div class="hero__acciones">
        <a class="boton boton--claro hero__boton" href={centro.whatsapp} rel="noopener">
          Escribir por WhatsApp
        </a>
        <a class="hero__telefono" href={`tel:${centro.telefonoTel}`}>
          {centro.telefono}
        </a>
      </div>

      <ul class="hero__registros" role="list">
        {registros.map((r) => <li>{r}</li>)}
      </ul>
    </div>
  </div>

  <!--
    Fuera del escenario a propósito: el escenario lo ancla ScrollTrigger y pasa
    a tener transformada propia. La flecha va fija al hueco de la pantalla y se
    retira al primer gesto de scroll, que es justo cuando deja de hacer falta.
  -->
  <div class="hero__flecha" data-hero-flecha aria-hidden="true">
    <svg viewBox="0 0 22 30" fill="none" stroke="currentColor" stroke-width="1.4">
      <path d="M11 1V27" stroke-linecap="round"></path>
      <path d="M3 20L11 28L19 20" stroke-linecap="round" stroke-linejoin="round"
      ></path>
    </svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
  }

  .hero__escenario {
    position: relative;
    height: 100dvh;
    min-height: 34rem;
    overflow: hidden;
    background: var(--crema);
    /* El brief fija el reparto: vidrio y hormigón en el 65% superior,
       todo el texto en el 35% inferior. */
    display: grid;
    grid-template-rows: 65fr 35fr;
  }

  .hero__ambiente,
  .hero__lienzo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Por defecto, hormigón: es el fondo seguro. Si el script no arranca o no
     hay WebGL, el texto del cuadro queda sobre crema y el contraste se
     mantiene en 14.29:1. */
  .hero__ambiente {
    /* Velo de carga: siempre por encima del render, nunca mezclado con él. */
    z-index: 3;
    background: var(--crema);
    opacity: 1;
    transition: opacity 460ms var(--ease-out);
  }

  /* Solo cuando hay JS que va a montar la escena se pinta el azul del primer
     fotograma. Plano, no en degradado: el gradiente imitaba el compuesto medido
     del muro, pero el corte contra el lienzo se veía igual y un campo plano no
     tiene costura que enseñar. */
  html.js .hero__ambiente {
    /* El primer render concentra el azul en la franja baja de las láminas
       (#287191 / #186986). Este tono intermedio cose el velo con esa zona
       oscura, en vez de arrancar demasiado luminoso y verdoso. */
    background: #1d617d;
  }

  /* Sin WebGL vuelve a hormigón: el texto tiene que poder leerse. */
  html.js .hero__ambiente.es-hormigon {
    background: var(--crema);
  }

  .hero__ambiente.esta-oculto {
    opacity: 0;
  }

  .hero__lienzo {
    z-index: 1;
    opacity: 1;
    transform: scale(var(--hero-esmerilado-zoom, 1));
  }

  /* Esmerilado de arranque.
     Con la cámara a 34 cm de la lámina central, el cuadro se llena de azul
     transmitido, pero la pared está 23 m detrás y se lee nítida a través del
     vidrio: se distinguen la junta con el suelo y el «05», y el arranque deja
     de ser una masa homogénea de color.

     Eso no es lo que hace un vidrio laminado de verdad. Pegado a él, el fondo
     lejano está fuera de foco y además lo difunde la lámina intermedia del
     laminado. Así que el primer tramo del recorrido lleva el desenfoque que le
     corresponde, y se retira a medida que la cámara se aleja: al 26% del
     recorrido ya es cero y el filtro se quita del todo, para no dejar una
     capa compuesta activa durante el resto del scroll. */
  .hero__lienzo.esta-esmerilado {
    filter: blur(var(--hero-esmerilado, 0px)) saturate(1.05);
    will-change: filter;
  }

  /* -- Flecha de arranque ------------------------------------------------- */
  .hero__flecha {
    position: fixed;
    left: 50%;
    bottom: clamp(0.75rem, 2.4vh, 1.75rem);
    z-index: 4;
    width: 22px;
    margin-left: -11px;
    color: var(--carbon);
    pointer-events: none;
    transition: opacity 420ms var(--ease-out);
  }

  .hero__flecha.esta-oculta {
    opacity: 0;
  }

  .hero__flecha svg {
    display: block;
    width: 100%;
    height: auto;
    /* El rebote no sale de cero y vuelve a cero: arranca ya desplazado hacia
       arriba, así el reposo del ciclo está en el punto alto y el gesto empuja
       hacia abajo, que es lo que se está pidiendo. */
    animation: hero-rebote 2s var(--ease-in-out) infinite;
  }

  @keyframes hero-rebote {
    0%,
    100% {
      transform: translate3d(0, -3px, 0);
    }
    50% {
      transform: translate3d(0, 4px, 0);
    }
  }

  .hero__velo {
    position: absolute;
    inset: auto 0 0;
    /* Seguro de contraste sobre la franja de texto.
       Sobre el hormigón, que ya es crema, este velo es literalmente invisible:
       crema sobre crema no cambia nada. Su trabajo aparece cuando una lámina
       cruza por detrás del texto, que es lo que pasa en pantallas bajas y a
       mitad del retroceso. Llega al 62% porque el antetítulo es la línea más
       alta del bloque y es la que se cruza con el vidrio. */
    height: 62%;
    z-index: 2;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--crema) 0%, transparent) 0%,
      color-mix(in srgb, var(--crema) 22%, transparent) 45%,
      color-mix(in srgb, var(--crema) 56%, transparent) 100%
    );
  }

  /* La opacidad de partida va en CSS y no la pone el script.
     Si la pone el script, entre el primer pintado y la ejecución del módulo
     hay una ventana en la que el texto se ve encima del campo azul del primer
     fotograma. El script sigue mandando después, porque escribe opacidad en
     línea y eso gana a la clase. Y si el script no llega, el plazo de gracia
     de la plantilla retira html.js y el texto vuelve a ser visible. */
  .hero__copia {
    position: relative;
    z-index: 4;
    grid-row: 2;
    align-self: center;
    display: grid;
    justify-items: center;
    gap: clamp(1rem, 2vh, 1.75rem);
    text-align: center;
    padding: 0 var(--gutter) clamp(1.5rem, 4vh, 3rem);
    max-width: var(--maxw);
    margin-inline: auto;
    width: 100%;
    will-change: opacity, transform;
  }

  html.js .hero__copia {
    opacity: 0;
  }

  .hero__antetitulo {
    /* Carbón y no el secundario: es la línea que puede quedar sobre vidrio, y
       aquí el contraste manda sobre la jerarquía. */
    color: var(--tinta);
    margin: 0;
  }

  .hero__titulo {
    font-size: var(--t-h1);
    font-weight: 300;
    line-height: 1.16;
    letter-spacing: var(--track-h1);
    text-indent: var(--track-h1);
    text-transform: uppercase;
    color: var(--carbon);
    margin: 0;
    max-width: 22ch;
  }

  .hero__areas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.15rem 0.85rem;
    font-size: var(--t-micro-2);
    font-weight: 450;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tinta);
    max-width: 74rem;
  }

  .hero__areas li + li::before {
    content: '·';
    display: inline-block;
    margin-right: 0.85rem;
    color: var(--piedra);
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    margin-top: clamp(0.25rem, 1.5vh, 1rem);
  }

  /* En el primer cuadro el botón vive sobre hormigón claro, no sobre vidrio:
     recupera la tinta carbón (14.29:1) y deja la variante clara para el
     tramo azul, donde el script la necesita. */
  .hero__boton {
    --boton-tinta: var(--carbon);
    --boton-borde: var(--filete-fuerte);
  }
  .hero__boton::before {
    background: var(--carbon);
  }
  @media (hover: hover) and (pointer: fine) {
    .hero__boton:hover {
      color: var(--crema);
      border-color: var(--carbon);
    }
  }

  .hero__telefono {
    color: var(--carbon);
    text-decoration: none;
    font-size: var(--t-cuerpo);
    letter-spacing: 0.2em;
    font-variant-numeric: tabular-nums;
    padding: 0.5rem 0;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-ui) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__telefono:hover {
      border-bottom-color: var(--carbon);
    }
  }

  .hero__registros {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.1rem 0.75rem;
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tinta-2);
    max-width: 72rem;
    line-height: 1.8;
  }

  .hero__registros li + li::before {
    content: '·';
    display: inline-block;
    margin-right: 0.75rem;
    color: var(--topo);
  }

  @media (max-width: 700px) {
    .hero__escenario {
      grid-template-rows: 52fr 48fr;
    }
    .hero__registros {
      letter-spacing: 0.1em;
    }
  }

  @media (max-height: 620px) and (min-width: 701px) {
    .hero__escenario {
      grid-template-rows: 55fr 45fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__flecha svg {
      animation: none;
    }
    .hero__flecha,
    .hero__ambiente,
    .hero__lienzo {
      transition: none;
    }
  }
</style>

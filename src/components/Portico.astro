---
import { Image } from 'astro:assets';
import { i18n } from '../i18n/index.js';


interface Miga {
  href: string;
  texto: string;
}

interface Props {
  marca: string;
  titulo: string;
  entradilla?: string;
  cuerpo?: string;
  migas?: Miga[];
  /** Nombre corto de esta página en el BreadcrumbList (por defecto, el título). */
  miga?: string;
  /** id del h1, para señalarlo desde fuera (destino de una transición de vista). */
  idTitulo?: string;
}

const { marca, titulo, entradilla, cuerpo, migas, miga = titulo, idTitulo } = Astro.props;
const { t } = i18n(Astro);

// La misma ruta de las migas, para buscadores: migas + página actual. Las URL
// llevan la misma barra final que el canonical.
const conBarra = Astro.url.pathname.length > 1 && Astro.url.pathname.endsWith('/');
const absoluta = (href) =>
  new URL(conBarra && !href.endsWith('/') ? `${href}/` : href, Astro.site).href;
const rastro = migas?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        ...migas.map((m) => ({ name: m.texto, item: absoluta(m.href) })),
        { name: miga, item: new URL(Astro.url.pathname, Astro.site).href },
      ].map((paso, i) => ({ '@type': 'ListItem', position: i + 1, ...paso })),
    }
  : null;
---

{rastro && <script type="application/ld+json" set:html={JSON.stringify(rastro)} />}

<header class="portico">
  <div class="portico__poro" aria-hidden="true"></div>

  <div class="envoltura portico__caja" data-revelar-grupo>
    {
      migas && migas.length > 0 && (
        <nav class="portico__migas" aria-label={t.portico.ruta}>
          <ol>
            {migas.map((m) => (
              <li>
                <a class="caps portico__miga" href={m.href}>
                  {m.texto}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <p class="caps portico__marca" data-revelar>{marca}</p>
    <h1 class="portico__titulo" id={idTitulo} data-revelar>{titulo}</h1>
    {entradilla && <p class="plomo portico__entradilla" data-revelar>{entradilla}</p>}
    {cuerpo && <p class="cuerpo cuerpo--2 portico__cuerpo" data-revelar>{cuerpo}</p>}
    <slot />
  </div>
</header>

<style>
  .portico {
    position: relative;
    isolation: isolate;
    background: var(--hormigon);
    padding-block: var(--paso-5) var(--paso-4);
  }

  .portico__poro {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: url('/media/tex/wall.webp');
    background-size: 900px auto;
    opacity: 0.42;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .portico__migas ol {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: var(--paso-2);
  }

  .portico__migas li + li::before {
    content: '';
    display: inline-block;
    width: 0.9rem;
    height: 1px;
    margin-right: 0.6rem;
    vertical-align: 0.35em;
    background: var(--topo);
  }

  .portico__miga {
    color: var(--tinta-2);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color var(--dur-ui) ease, border-color var(--dur-ui) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .portico__miga:hover {
      color: var(--acento-fuerte);
      border-bottom-color: var(--acento-fuerte);
    }
  }

  .portico__marca {
    color: var(--tinta-2);
  }

  .portico__titulo {
    margin-top: var(--paso-1);
    font-size: var(--t-h1);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-indent: 0.05em;
    text-wrap: balance;
    max-width: 22ch;
  }

  .portico__entradilla {
    margin-top: var(--paso-3);
    max-width: 52ch;
  }

  .portico__cuerpo {
    margin-top: var(--paso-2);
  }
</style>

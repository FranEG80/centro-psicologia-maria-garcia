---
import { prisma } from '../data/contenido.js';

const { texto, autor } = prisma;
---

<section class="prisma">
  <hr class="canto" />

  <div class="prisma__banda">
    <div class="prisma__haz" aria-hidden="true"></div>

    <div class="envoltura prisma__caja">
      <blockquote class="prisma__cita">
        <p class="prisma__texto">{texto}</p>
        {
          autor && (
            <footer class="prisma__autoria">
              <cite class="prisma__autor">{autor}</cite>
            </footer>
          )
        }
      </blockquote>
    </div>
  </div>

  <hr class="canto" />
</section>

<style>
  .prisma {
    background: var(--petroleo);
    color: var(--crema);
  }

  .prisma__banda {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }

  .prisma__haz {
    position: absolute;
    inset: 0 -34%;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(
      212deg,
      transparent 30%,
      color-mix(in srgb, var(--crema) 6%, transparent) 48%,
      color-mix(in srgb, var(--crema) 18%, transparent) 64%,
      color-mix(in srgb, var(--crema) 34%, transparent) 80%,
      color-mix(in srgb, var(--crema) 20%, transparent) 92%,
      transparent 100%
    );
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .prisma__haz {
        animation: deriva-luz linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }

      @keyframes deriva-luz {
        from {
          translate: -24% 0;
        }
        to {
          translate: 24% 0;
        }
      }
    }
  }

  .prisma__caja {
    position: relative;
    z-index: 1;
    padding-block: var(--paso-5);
    display: flex;
    justify-content: flex-end;
  }

  .prisma__cita {
    max-width: 44rem;
  }

  .prisma__texto {
    font-size: var(--t-h2);
    font-weight: 300;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-indent: 0.08em;
    text-wrap: balance;
  }

  .prisma__autoria {
    margin-top: var(--paso-2);
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .prisma__autoria::before {
    content: '';
    width: 2.5rem;
    height: 1px;
    background: color-mix(in srgb, var(--canto) 70%, transparent);
  }

  .prisma__autor {
    font-size: var(--t-micro-2);
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--campo-tinta-2);
  }

  @media (max-width: 900px) {
    .prisma__caja {
      justify-content: flex-start;
    }
    .prisma__cita {
      max-width: none;
    }
    .prisma__texto {
      letter-spacing: 0.06em;
      text-indent: 0.06em;
    }
  }
</style>

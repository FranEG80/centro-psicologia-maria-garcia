---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Portico from '../components/Portico.astro';
import Pie from '../components/Pie.astro';
import Boton from '../components/Boton.astro';
import { centro, formacion, perfil, trayectoria } from '../data/contenido.js';
import { sobreMi } from '../data/paginas.js';

---

<Base
  titulo={`Sobre mí · ${centro.profesional}`}
  descripcion={`${centro.profesional}, psicóloga sanitaria y mediadora familiar en ${centro.localidad} desde ${centro.desde}. Especialista en Neuropsicología y Psicología Jurídica y Forense.`}
>
  <Nav />

  <main id="contenido">
    <Portico
      marca={sobreMi.marca}
      titulo={sobreMi.titulo}
      entradilla={sobreMi.entradilla}
      cuerpo={sobreMi.cuerpo}
      migas={[{ href: '/', texto: 'Inicio' }]}
    >
      <p class="caps portico__oficio" data-revelar>{sobreMi.sumario}</p>
    </Portico>

    <section class="quien" aria-labelledby="quien-titulo">
      <h2 class="solo-lectores" id="quien-titulo">Quién atiende</h2>

      <div class="envoltura quien__reticula" data-revelar-grupo>
        <div class="quien__figura" data-revelar="lamina" aria-hidden="true">
          <div class="quien__hueco">
            <span class="quien__marco"></span>
          </div>
        </div>

        <div class="quien__texto">
          <p class="plomo quien__plomo" data-revelar>
            {perfil.trayectoria}
          </p>
          <p class="quien__detalle" data-revelar>
            La misma profesional realiza la valoración, interviene y acompaña
            durante todo el proceso.
          </p>
        </div>
        <div class="quien__datos">
          <dl class="registros" data-revelar>
            {
              centro.credenciales.map((c) => (
                <div class="registro">
                  <dt class="registro__etiqueta">{c.etiqueta}</dt>
                  <dd class="registro__valor">{c.valor}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <section class="compromiso" aria-labelledby="compromiso-titulo">
      <div class="envoltura compromiso__reticula" data-revelar-grupo>
        <h2 class="h2 compromiso__titulo" id="compromiso-titulo" data-revelar>
          Mi compromiso contigo
        </h2>
        <div class="compromiso__texto" data-revelar>
          {perfil.compromiso.map((parrafo) => <p>{parrafo}</p>)}
        </div>
      </div>
    </section>

    <section class="curriculo" aria-labelledby="curriculo-titulo">
      <h2 class="solo-lectores" id="curriculo-titulo">
        Formación y trayectoria
      </h2>

      <div class="envoltura curriculo__reticula" data-revelar-grupo>
        <div class="columna" data-revelar>
          <h3 class="caps columna__epigrafe">Formación</h3>
          <ul class="columna__lista">
            {formacion.map((f) => <li class="columna__punto">{f}</li>)}
          </ul>
        </div>

        <div class="columna" data-revelar>
          <h3 class="caps columna__epigrafe">Trayectoria</h3>
          <ul class="columna__lista">
            {trayectoria.map((t) => <li class="columna__punto">{t}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="alcance" aria-labelledby="alcance-titulo">
      <hr class="canto" />
      <div class="envoltura alcance__caja">
        <h2 class="alcance__titulo" id="alcance-titulo">
          Tres formaciones, un solo despacho
        </h2>
        <p class="alcance__texto">
          La neuropsicología, el ámbito jurídico y forense y la mediación
          familiar no suelen coincidir en la misma profesional. Aquí sí, y por
          eso el mismo despacho puede valorar a un niño con dificultades de
          aprendizaje, mediar en una separación y elaborar un informe pericial.
        </p>
        <Boton class="alcance__boton" variant="claro" href="/areas">
          Ver las áreas
        </Boton>
      </div>
    </section>
  </main>

  <Pie />
</Base>

<style>
  .portico__oficio {
    margin-top: var(--paso-2);
    color: var(--acento-fuerte);
  }

  .quien {
    background: var(--vidrio-hoja);
    color: var(--carbon);
    border-top: 1px solid var(--canto);
    padding-block: var(--paso-5);
  }

  .quien__reticula {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--paso-4);
    align-items: start;
  }

  .quien__figura {
    grid-row: span 2;
    background: var(--crema);
    padding: var(--paso-2);
    box-shadow: var(--sombra-baja);
  }

  .quien__hueco {
    position: relative;
    height: clamp(20rem, 42vw, 34rem);
    background: color-mix(in srgb, var(--topo) 12%, transparent);
  }

  .quien__marco {
    position: absolute;
    inset: 0;
    border: 1px solid var(--filete);
    pointer-events: none;
  }

  .quien__detalle {
    margin-top: var(--paso-2);
    max-width: 42ch;
  }

  .registros {
    margin-top: var(--paso-3);
    display: grid;
    gap: var(--paso-1);
    border-top: 1px solid var(--filete-hoja);
    padding-top: var(--paso-2);
  }

  .registro {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.9rem;
  }

  .registro__etiqueta {
    font-size: var(--t-micro);
    font-weight: 450;
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--tinta-hoja);
  }

  .registro__valor {
    font-size: var(--t-lista);
    font-variant-numeric: tabular-nums;
  }

  .compromiso {
    padding-block: var(--paso-5);
    border-top: 1px solid var(--canto);
    background: var(--vidrio-hoja);
    color: var(--carbon);
  }

  .compromiso__reticula {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--paso-4);
    align-items: start;
  }

  .compromiso__texto {
    padding-left: var(--paso-2);
    border-left: 1px solid var(--acento);
    font-size: var(--t-cuerpo-lg);
    font-weight: 300;
    line-height: 1.5;
    max-width: 49ch;
  }

  .compromiso__texto p + p {
    margin-top: var(--paso-2);
  }

  .curriculo {
    background: var(--hormigon);
    position: relative;
    isolation: isolate;
    border-top: 1px solid var(--canto);
    padding-block: var(--paso-5);
  }

  .curriculo::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: url('/media/tex/wall.webp');
    background-size: 900px auto;
    opacity: 0.4;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .curriculo__reticula {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--paso-4);
    align-items: start;
  }

  .columna__epigrafe {
    color: var(--tinta-2);
    padding-bottom: var(--paso-2);
    border-bottom: 1px solid var(--filete);
  }

  .columna__lista {
    margin-top: var(--paso-2);
    display: grid;
    gap: var(--paso-2);
    font-size: var(--t-lista);
  }

  .columna__punto {
    position: relative;
    padding-left: 1.6em;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .columna__punto::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.74em;
    width: 0.8em;
    height: 1px;
    background: var(--acento);
  }

  .alcance {
    background: var(--petroleo);
    color: var(--crema);
  }

  .alcance__caja {
    padding-block: var(--paso-5);
  }

  .alcance__titulo {
    font-size: var(--t-h2);
    font-weight: 300;
    line-height: 1.14;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-indent: 0.06em;
    max-width: 18ch;
    text-wrap: balance;
  }

  .alcance__texto {
    margin-top: var(--paso-3);
    font-size: var(--t-cuerpo-lg);
    font-weight: 300;
    line-height: 1.5;
    max-width: 58ch;
    text-wrap: pretty;
  }

  .alcance__boton {
    margin-top: var(--paso-3);
  }

  @media (max-width: 900px) {
    .quien__reticula,
    .compromiso__reticula,
    .curriculo__reticula {
      grid-template-columns: minmax(0, 1fr);
    }
    .quien__figura {
      grid-row: auto;
    }
    .quien__hueco {
      height: clamp(16rem, 58vw, 24rem);
    }
  }
</style>

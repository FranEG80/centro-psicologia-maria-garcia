---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Prisma from '../components/Prisma.astro';
import AreasLaminas from '../components/AreasLaminas.astro';
import Ambientes from '../components/Ambientes.astro';
import Profesional from '../components/Profesional.astro';
import Pie from '../components/Pie.astro';
import { i18n } from '../i18n/index.js';

const { d } = i18n(Astro);
const { centro, metas } = d;
---

<Base titulo={metas.inicio.titulo(centro)} descripcion={metas.inicio.descripcion(centro)}>
  <Nav />
  <main id="contenido" tabindex="-1">
    <Hero />
    <Prisma />
    <AreasLaminas />
    <Ambientes />
    <Profesional />
  </main>
  <Pie />
</Base>

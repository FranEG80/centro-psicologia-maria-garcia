---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Manifiesto from '../components/Manifiesto.astro';
import Areas from '../components/Areas.astro';
import SobreMi from '../components/SobreMi.astro';
import Centro from '../components/Centro.astro';
import Materiales from '../components/Materiales.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---

<Base
  titulo="Centro de Psicología María García · Motril, Granada"
  descripcion="Psicología general, infantil y juvenil, mediación familiar, neuropsicología y psicología jurídica y forense en Motril. María García Molina, psicóloga sanitaria y mediadora familiar desde 2005."
>
  <Nav />
  <main>
    <Hero />
    <Manifiesto />
    <Areas />
    <SobreMi />
    <Centro />
    <Materiales />
    <Contacto />
  </main>
  <Footer />
</Base>

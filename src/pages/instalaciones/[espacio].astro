---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Pie from '../../components/Pie.astro';
import Boton from '../../components/Boton.astro';
import { centro, ambientes } from '../../data/contenido.js';

import officeDarkwood from '../../assets/photo/office-darkwood.webp';
import officeCalm from '../../assets/photo/office-calm.webp';
import officeFamily from '../../assets/photo/office-family.webp';
import childrenRoom from '../../assets/photo/children-room.webp';
import reception from '../../assets/photo/reception.webp';
import waitingRoom from '../../assets/photo/waiting-room.webp';

export function getStaticPaths() {
  return [
    {
      params: { espacio: 'adultos' },
      props: {
        titulo: 'Los despachos',
        sumario: 'Adultos, pareja y familia',
        entradilla:
          'Salas de consulta tranquilas para hablar con calma, ya vengas solo, en pareja o con tu familia.',
        vistas: [officeDarkwood, officeCalm, officeFamily],
        alts: [
          'Despacho de consulta del Centro de Psicología María García.',
          'El mismo despacho, con la ventana y la luz natural al fondo.',
          'Segundo despacho del centro, de tonos claros.',
        ],
        notas: [
          'Sesiones individuales, de pareja y de familia.',
          'Valoración, intervención y seguimiento en el mismo espacio y con la misma persona.',
          'Distintas salas de trabajo según las necesidades de cada paciente.',
        ],
      },
    },
    {
      params: { espacio: 'infantil' },
      props: {
        titulo: 'La zona infantil',
        sumario: 'Un espacio para niños',
        entradilla:
          'Una sala aparte, a su altura y con su propio material. Aquí se trabaja jugando, porque jugando es como un niño cuenta lo que le pasa.',
        vistas: [childrenRoom],
        alts: ['Zona infantil del centro, con mesa baja, sillas pequeñas y pizarra.'],
        notas: [
          'Valoración e intervención con niños.',
          'Pruebas y material de trabajo pensados para su edad.',
          'La sala juvenil es un espacio distinto de esta zona infantil.',
        ],
      },
    },
    {
      params: { espacio: 'juvenil' },
      props: {
        titulo: 'La sala juvenil',
        sumario: 'Un espacio para adolescentes',
        entradilla:
          'La atención a adolescentes cuenta con una sala de trabajo propia, distinta de la zona infantil.',
        vistas: [],
        alts: [],
        notas: [
          'Una sala independiente de la zona infantil.',
          'El espacio se adapta a la edad y a las necesidades de cada paciente.',
        ],
      },
    },
  ];
}

const { titulo, sumario, entradilla, vistas, alts, notas } =
  Astro.props;

const otros = ambientes.filter((a) => !a.href.endsWith(Astro.params.espacio));
---

<Base titulo={`${titulo} · ${centro.nombre}`} descripcion={entradilla}>
  <Nav />

  <main id="contenido">
    <article class="espacio">
      <header class="envoltura espacio__portico" data-revelar-grupo>
        <p class="caps espacio__marca" data-revelar>{sumario}</p>
        <h1 class="espacio__titulo" data-revelar>{titulo}</h1>
        <p class="plomo espacio__entradilla" data-revelar>{entradilla}</p>
      </header>

      {vistas.length ? (
        <div
          class="espacio__tira"
          data-revelar-grupo
          style={`--vistas:${vistas.length}`}
        >
          {vistas.map((v, i) => (
            <figure class="vista" data-revelar="lamina">
              <Image
                src={v}
                widths={[520, 780, 1040]}
                sizes={vistas.length > 1 ? '(max-width: 860px) 100vw, 33vw' : '100vw'}
                alt={alts[i]}
                loading="eager"
                decoding="async"
              />
            </figure>
          ))}
        </div>
      ) : (
        <div class="espacio__marco" aria-hidden="true"></div>
      )}

      <div class="envoltura espacio__cierre">
        <ul class="espacio__notas" data-revelar-grupo>
          {
            notas.map((n) => (
              <li class="espacio__nota" data-revelar>
                {n}
              </li>
            ))
          }
        </ul>

        <aside class="espacio__resto">
          <h2 class="caps espacio__epigrafe">El resto del centro</h2>
          <div class="espacio__miniaturas">
            <figure class="mini">
              <Image
                src={reception}
                widths={[280, 420]}
                sizes="(max-width: 640px) 45vw, 220px"
                alt="Recepción del centro."
                loading="eager"
                fetchpriority="low"
                decoding="async"
              />
              <figcaption class="mini__pie">Recepción</figcaption>
            </figure>
            <figure class="mini">
              <Image
                src={waitingRoom}
                widths={[280, 420]}
                sizes="(max-width: 640px) 45vw, 220px"
                alt="Sala de espera del centro."
                loading="eager"
                fetchpriority="low"
                decoding="async"
              />
              <figcaption class="mini__pie">Sala de espera</figcaption>
            </figure>
          </div>

          {otros.map((otro) => (
            <Boton class="espacio__boton" href={otro.href}>
              Ver {otro.titulo.toLowerCase()}
            </Boton>
          ))}
        </aside>
      </div>

    </article>
  </main>

  <Pie />
</Base>

<style>
  .espacio {
    background: var(--hormigon);
    position: relative;
    isolation: isolate;
    padding-block: var(--paso-5) var(--paso-6);
  }

  .espacio::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: url('/media/tex/wall.webp');
    background-size: 900px auto;
    opacity: 0.42;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .espacio__portico {
    margin-bottom: var(--paso-4);
  }

  .espacio__marca {
    color: var(--tinta-2);
  }

  .espacio__titulo {
    margin-top: var(--paso-1);
    font-size: var(--t-h1);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-indent: 0.05em;
  }

  .espacio__entradilla {
    margin-top: var(--paso-3);
  }

  .espacio__tira {
    display: grid;
    grid-template-columns: repeat(var(--vistas, 2), minmax(0, 1fr));
    border-block: 1px solid var(--filete);
  }

  .vista + .vista {
    border-left: 1px solid var(--filete);
  }

  .vista img {
    width: 100%;
    height: clamp(18rem, 34vw, 30rem);
    object-fit: cover;
  }

  .espacio__marco {
    width: 100%;
    height: clamp(18rem, 34vw, 30rem);
    background: var(--lino);
  }

  .espacio__cierre {
    margin-top: var(--paso-5);
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--paso-4);
    align-items: start;
  }

  .espacio__notas {
    display: grid;
    gap: var(--paso-2);
    font-size: var(--t-lista);
    max-width: 52ch;
  }

  .espacio__nota {
    position: relative;
    padding-left: 1.6em;
    text-wrap: pretty;
  }

  .espacio__nota::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.74em;
    width: 0.8em;
    height: 1px;
    background: var(--acento);
  }

  .espacio__epigrafe {
    color: var(--tinta-2);
    margin-bottom: var(--paso-2);
  }

  .espacio__miniaturas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--paso-2);
  }

  .mini img {
    width: 100%;
    height: clamp(7rem, 14vw, 10rem);
    object-fit: cover;
  }

  .mini__pie {
    margin-top: 0.5rem;
    font-size: var(--t-micro);
    color: var(--tinta-2);
  }

  .espacio__boton {
    margin-top: var(--paso-3);
  }

  @media (max-width: 860px) {
    .espacio__tira {
      grid-template-columns: minmax(0, 1fr);
    }
    .vista + .vista {
      border-left: 0;
      border-top: 1px solid var(--filete);
    }
    .espacio__cierre {
      grid-template-columns: minmax(0, 1fr);
    }
  }

</style>

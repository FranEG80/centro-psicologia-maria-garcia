---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Portico from '../../components/Portico.astro';
import Pie from '../../components/Pie.astro';
import { centro, areas } from '../../data/contenido.js';
import { detallesAreas, metaAreas } from '../../data/paginas.js';

export function getStaticPaths() {
  return areas.map((area) => ({
    params: { area: area.id },
    props: { area },
  }));
}

const { area } = Astro.props;
const detalle = detallesAreas[area.id];

const i = areas.findIndex((a) => a.id === area.id);
const anterior = areas[(i - 1 + areas.length) % areas.length];
const siguiente = areas[(i + 1) % areas.length];
---

<Base
  titulo={`${area.titulo} · ${centro.nombre}`}
  descripcion={metaAreas[area.id]}
>
  <Nav />

  <main id="contenido">
    <Portico
      marca={area.sumario}
      titulo={area.titulo}
      entradilla={detalle.entradilla}
      cuerpo={detalle.cuerpo}
      migas={[
        { href: '/', texto: 'Inicio' },
        { href: '/areas', texto: 'Áreas' },
      ]}
    />

    <section class="listado" aria-labelledby="listado-titulo">
      <div class="envoltura listado__reticula" data-revelar-grupo>
        <div class="listado__texto">
          <h2 class="caps listado__epigrafe" id="listado-titulo" data-revelar>
            {detalle.listadoTitulo ?? 'Se valora e interviene en'}
          </h2>

          <ul class="listado__puntos" data-revelar>
            {area.puntos.map((p) => <li class="listado__punto">{p}</li>)}
          </ul>

          {
            detalle.acreditacion && (
              <div class="acreditacion" data-revelar>
                <h3 class="caps acreditacion__epigrafe">
                  {detalle.acreditacion.epigrafe}
                </h3>
                <p class="acreditacion__texto">{detalle.acreditacion.texto}</p>
              </div>
            )
          }
        </div>

        <div class="listado__galeria">
          <figure class="listado__figura" data-revelar="lamina">
            <Image
              src={detalle.imagen.src}
              widths={[420, 640, 860]}
              sizes="(max-width: 900px) 100vw, 40vw"
              alt={detalle.imagen.alt}
              loading="eager"
              fetchpriority="low"
              decoding="async"
            />
            {
              detalle.imagen.pie && (
                <figcaption class="caps caps--contenido listado__pie">
                  {detalle.imagen.pie}
                </figcaption>
              )
            }
          </figure>
          {
            detalle.imagenAdicional && (
              <figure class="listado__figura listado__figura--adicional" data-revelar="lamina">
                <Image
                  src={detalle.imagenAdicional.src}
                  widths={[420, 640, 860]}
                  sizes="(max-width: 900px) 100vw, 40vw"
                  alt={detalle.imagenAdicional.alt}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            )
          }
        </div>
      </div>
    </section>

    {
      detalle.ambitos && (
        <section class="ambitos" aria-labelledby="ambitos-titulo">
          <div class="envoltura">
            <h2 class="h2 ambitos__titulo" id="ambitos-titulo">
              Áreas de actuación
            </h2>
            <div class="ambitos__lista" data-revelar-grupo>
              {detalle.ambitos.map((ambito) => (
                <article class="ambitos__item" data-revelar>
                  <h3 class="h3 ambitos__nombre">{ambito.titulo}</h3>
                  <p class="ambitos__texto">{ambito.texto}</p>
                </article>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section class="cuando" aria-labelledby="cuando-titulo">
      <hr class="canto" />
      <div class="envoltura cuando__caja">
        <h2 class="cuando__titulo" id="cuando-titulo">
          {detalle.cierre.epigrafe}
        </h2>
        <p class="cuando__texto">{detalle.cierre.texto}</p>
      </div>
    </section>

    <nav class="vecinas" aria-label="Otras áreas">
      <div class="envoltura vecinas__reticula">
        <a class="vecina vecina--atras" href={`/areas/${anterior.id}`}>
          <span class="caps vecina__marca">Área anterior</span>
          <span class="vecina__nombre">{anterior.titulo}</span>
        </a>
        <a class="vecina vecina--adelante" href={`/areas/${siguiente.id}`}>
          <span class="caps vecina__marca">Área siguiente</span>
          <span class="vecina__nombre">{siguiente.titulo}</span>
        </a>
      </div>
      <p class="envoltura vecinas__todas">
        <a class="enlace" href="/areas">Ver las áreas</a>
      </p>
    </nav>
  </main>

  <Pie />
</Base>

<style>
  .listado {
    background: var(--vidrio-hoja);
    color: var(--carbon);
    border-top: 1px solid var(--canto);
    padding-block: var(--paso-5);
  }

  .listado__reticula {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--paso-4);
    align-items: start;
  }

  .listado__epigrafe {
    color: var(--tinta-hoja);
  }

  .listado__puntos {
    margin-top: var(--paso-3);
    display: grid;
    gap: var(--paso-2);
    font-size: var(--t-lista);
    max-width: 58ch;
  }

  .listado__punto {
    position: relative;
    padding-left: 1.6em;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .listado__punto::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.74em;
    width: 0.8em;
    height: 1px;
    background: var(--petroleo-800);
  }

  .acreditacion {
    margin-top: var(--paso-3);
    padding-top: var(--paso-2);
    border-top: 1px solid var(--filete-hoja);
    max-width: 44ch;
  }

  .acreditacion__epigrafe {
    color: var(--tinta-hoja);
  }

  .acreditacion__texto {
    margin-top: var(--paso-1);
    font-size: var(--t-lista);
    font-variant-numeric: tabular-nums;
  }

  .listado__galeria {
    display: grid;
    gap: var(--paso-2);
  }

  .listado__figura {
    background: var(--crema);
    padding: var(--paso-2);
    box-shadow: var(--sombra-baja);
  }

  .listado__figura img {
    width: 100%;
    height: clamp(15rem, 30vw, 24rem);
    object-fit: cover;
  }

  .listado__figura--adicional img {
    height: clamp(10rem, 20vw, 16rem);
  }

  .listado__pie {
    margin-top: var(--paso-2);
    color: var(--tinta-2);
  }

  .ambitos {
    background: var(--hormigon);
    border-top: 1px solid var(--canto);
    padding-block: var(--paso-5);
  }

  .ambitos__titulo {
    margin-bottom: var(--paso-4);
  }

  .ambitos__lista {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--filete);
  }

  .ambitos__item {
    padding: var(--paso-3) var(--paso-3) 0 0;
  }

  .ambitos__item + .ambitos__item {
    border-left: 1px solid var(--filete);
    padding-left: var(--paso-3);
  }

  .ambitos__texto {
    margin-top: var(--paso-2);
    max-width: 36ch;
    color: var(--tinta-2);
    text-wrap: pretty;
  }

  .cuando {
    background: var(--petroleo);
    color: var(--crema);
  }

  .cuando__caja {
    padding-block: var(--paso-5);
  }

  .cuando__titulo {
    font-size: var(--t-h2);
    font-weight: 300;
    line-height: 1.14;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-indent: 0.06em;
    max-width: 18ch;
    text-wrap: balance;
  }

  .cuando__texto {
    margin-top: var(--paso-3);
    font-size: var(--t-cuerpo-lg);
    font-weight: 300;
    line-height: 1.5;
    max-width: 58ch;
    text-wrap: pretty;
  }

  .vecinas {
    background: var(--hormigon);
    border-top: 1px solid var(--canto);
    padding-block: var(--paso-4);
  }

  .vecinas__reticula {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--paso-2);
  }

  .vecina {
    display: flex;
    flex-direction: column;
    gap: var(--paso-1);
    padding: var(--paso-2) 0;
    color: var(--carbon);
    text-decoration: none;
    border-top: 1px solid var(--filete);
    transition: color var(--dur-ui) ease;
  }

  .vecina--adelante {
    text-align: right;
  }

  .vecina__marca {
    color: var(--tinta-2);
  }

  .vecina__nombre {
    font-size: var(--t-h3);
    font-weight: 300;
    line-height: 1.2;
    text-wrap: balance;
  }

  @media (hover: hover) and (pointer: fine) {
    .vecina:hover {
      color: var(--acento-fuerte);
    }
  }

  .vecinas__todas {
    margin-top: var(--paso-3);
    font-size: var(--t-micro-2);
  }

  @media (max-width: 900px) {
    .listado__reticula {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 860px) {
    .ambitos__lista {
      grid-template-columns: minmax(0, 1fr);
    }
    .ambitos__item,
    .ambitos__item + .ambitos__item {
      border-left: 0;
      padding: var(--paso-3) 0;
    }
    .ambitos__item + .ambitos__item {
      border-top: 1px solid var(--filete);
    }
  }

  @media (max-width: 560px) {
    .vecinas__reticula {
      grid-template-columns: minmax(0, 1fr);
    }
    .vecina--adelante {
      text-align: left;
    }
  }
</style>

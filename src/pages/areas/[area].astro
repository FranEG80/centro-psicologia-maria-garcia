---
import Foto from '../../components/Foto.astro';
import CitaArea from '../../components/CitaArea.astro';
import IconoArea from '../../components/IconoArea.astro';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Portico from '../../components/Portico.astro';
import Pie from '../../components/Pie.astro';
import { i18n, rutasEstaticas } from '../../i18n/index.js';

export function getStaticPaths() {
  return rutasEstaticas('area', 'es');
}

const { id } = Astro.props;
const { t, d, ruta } = i18n(Astro);
const { centro, areas, detallesAreas, metaAreas } = d;
const area = areas.find((a) => a.id === id);
const detalle = detallesAreas[id];

const otras = areas.filter((a) => a.id !== id);
---

<Base
  titulo={`${area.titulo} · ${centro.nombre}`}
  descripcion={metaAreas[area.id]}
>
  <Nav />

  <main id="contenido">
    <Portico
      marca={area.sumario}
      titulo={area.titulo}
      entradilla={detalle.entradilla}
      cuerpo={detalle.cuerpo}
      migas={[
        { href: ruta('inicio'), texto: t.migas.inicio },
        { href: ruta('areas'), texto: t.migas.areas },
      ]}
      image={detalle.imagenAdicional}
    />
    <section class="listado" aria-labelledby="listado-titulo">
      <div class="envoltura listado__reticula" data-revelar-grupo>
        <div class="listado__texto">
          <h2 class="caps listado__epigrafe" id="listado-titulo" data-revelar>
            {detalle.listadoTitulo ?? t.areas.listadoPorDefecto}
          </h2>

          <ul class="listado__puntos" data-revelar>
            {area.puntos.map((p) => <li class="listado__punto">{p}</li>)}
          </ul>

          {
            detalle.acreditacion && (
              <div class="acreditacion" data-revelar>
                <h3 class="caps acreditacion__epigrafe">
                  {detalle.acreditacion.epigrafe}
                </h3>
                <p class="acreditacion__texto">{detalle.acreditacion.texto}</p>
              </div>
            )
          }
        </div>

        <div class="listado__galeria">
          <figure class="listado__figura" data-revelar>
            <Foto
              src={detalle.imagen.src}
              widths={[420, 640, 860]}
              sizes="(max-width: 900px) 100vw, 40vw"
              alt={detalle.imagen.alt}
              loading="eager"
              fetchpriority="low"
              decoding="async"
            />
            <!-- {
              detalle.imagen.pie && !detalle.imagenComplementaria && (
                <figcaption class="caps caps--contenido listado__pie">
                  {detalle.imagen.pie}
                </figcaption>
              )
            } -->
          </figure>
          {
            detalle.imagenComplementaria && (
              <figure class="listado__figura listado__figura--adicional" data-revelar>
                <Foto
                  src={detalle.imagenComplementaria.src}
                  widths={[420, 640, 860]}
                  sizes="(max-width: 900px) 100vw, 40vw"
                  alt={detalle.imagenComplementaria.alt}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            )
          }
          <!-- {detalle.imagenComplementaria && detalle.imagen.pie && (
            <p class="caps caps--contenido listado__pie listado__pie--conjunto">
              {detalle.imagen.pie}
            </p>
          )} -->
        </div>
      </div>
    </section>

    {
      detalle.ambitos && (
        <section class="ambitos" aria-labelledby="ambitos-titulo">
          <div class="envoltura">
            <h2 class="h2 ambitos__titulo" id="ambitos-titulo">
              {t.areas.ambitos}
            </h2>
            <div class="ambitos__lista" data-revelar-grupo>
              {detalle.ambitos.map((ambito) => (
                <article class="ambitos__item" data-revelar>
                  <h3 class="h3 ambitos__nombre">{ambito.titulo}</h3>
                  <p class="ambitos__texto">{ambito.texto}</p>
                </article>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {detalle.cita && <CitaArea texto={detalle.cita.texto} autor={detalle.cita.autor} />}

    <section class="cuando" aria-labelledby="cuando-titulo">
      <hr class="canto" />
      <div class="envoltura cuando__caja">
        <h2 class="cuando__titulo" id="cuando-titulo">
          {detalle.cierre.epigrafe}
        </h2>
        <p class="cuando__texto">{detalle.cierre.texto}</p>
      </div>
    </section>

    <nav class="vecinas" aria-labelledby="vecinas-titulo">
      <div class="envoltura">
        <h2 class="caps vecinas__titulo" id="vecinas-titulo">{t.areas.otras}</h2>
        <ul class="vecinas__reticula" data-revelar-grupo>
          {otras.map((a) => (
            <li class="vecina" data-revelar>
              <a class="vecina__enlace" href={ruta('area', a.id)}>
                <span class="vecina__icono" aria-hidden="true">
                  <IconoArea id={a.id} />
                </span>
                <span class="vecina__texto">
                  <span class="vecina__nombre">{a.titulo}</span>
                  <span class="vecina__sumario">{a.sumario}</span>
                </span>
                <span class="vecina__flecha" aria-hidden="true">
                  <svg viewBox="0 0 24 10" width="24" height="10" fill="none">
                    <path d="M0 5h22M18 1l4 4-4 4" stroke="currentColor" stroke-width="1" />
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  </main>

  <Pie />
</Base>

<style>
  .listado {
    background: var(--vidrio-hoja);
    color: var(--carbon);
    border-top: 1px solid var(--canto);
    padding-block: var(--paso-5);
  }

  .listado__reticula {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--paso-4);
    align-items: start;
  }

  .listado__epigrafe {
    color: var(--tinta-hoja);
  }

  .listado__puntos {
    margin-top: var(--paso-3);
    display: grid;
    gap: var(--paso-2);
    font-size: var(--t-lista);
    max-width: 58ch;
  }

  .listado__punto {
    position: relative;
    padding-left: 1.6em;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .listado__punto::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.74em;
    width: 0.8em;
    height: 1px;
    background: var(--petroleo-800);
  }

  .acreditacion {
    margin-top: var(--paso-3);
    padding-top: var(--paso-2);
    border-top: 1px solid var(--filete-hoja);
    max-width: 44ch;
  }

  .acreditacion__epigrafe {
    color: var(--tinta-hoja);
  }

  .acreditacion__texto {
    margin-top: var(--paso-1);
    font-size: var(--t-lista);
    font-variant-numeric: tabular-nums;
  }

  .listado__galeria {
    display: grid;
    gap: var(--paso-2);
  }

  .listado__figura {
    background: var(--crema);
    padding: var(--paso-2);
    box-shadow: var(--sombra-baja);
  }

  .listado__galeria .listado__figura {
    --revelar-y: 56px;
  }

  html.js .listado__galeria .listado__figura.es-visible {
    transition-duration: 1100ms;
  }

  html.js .listado__galeria .listado__figura--adicional.es-visible {
    transition-delay: calc(var(--revelar-retardo, 0ms) + 160ms);
  }

  .listado__figura img {
    width: 100%;
    height: clamp(15rem, 30vw, 24rem);
    object-fit: cover;
  }

  .listado__figura--adicional img {
    height: clamp(10rem, 20vw, 16rem);
  }

  .listado__pie {
    margin-top: var(--paso-2);
    color: var(--tinta-2);
  }

  .ambitos {
    background: var(--hormigon);
    border-top: 1px solid var(--canto);
    padding-block: var(--paso-5);
  }

  .ambitos__titulo {
    margin-bottom: var(--paso-4);
  }

  .ambitos__lista {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--filete);
  }

  .ambitos__item {
    padding: var(--paso-3) var(--paso-3) 0 0;
  }

  .ambitos__item + .ambitos__item {
    border-left: 1px solid var(--filete);
    padding-left: var(--paso-3);
  }

  .ambitos__texto {
    margin-top: var(--paso-2);
    max-width: 36ch;
    color: var(--tinta-2);
    text-wrap: pretty;
  }

  .cuando {
    background: var(--petroleo);
    color: var(--crema);
  }

  .cuando__caja {
    padding-block: var(--paso-5);
  }

  .cuando__titulo {
    font-size: var(--t-h2);
    font-weight: 300;
    line-height: 1.14;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-indent: 0.06em;
    max-width: 18ch;
    text-wrap: balance;
  }

  .cuando__texto {
    margin-top: var(--paso-3);
    font-size: var(--t-cuerpo-lg);
    font-weight: 300;
    line-height: 1.5;
    max-width: 58ch;
    text-wrap: pretty;
  }

  .vecinas {
    background: var(--hormigon);
    border-top: 1px solid var(--canto);
    padding-block: var(--paso-4);
  }

  .vecinas__titulo {
    color: var(--tinta-2);
    margin-bottom: var(--paso-2);
  }

  .vecinas__reticula {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--paso-3);
  }

  .vecina {
    position: relative;
  }

  /* Filete: se traza de izquierda a derecha al revelarse, escalonado con el grupo. */
  .vecina::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: var(--filete);
    transform-origin: left;
  }

  :global(html.js) .vecina::before {
    transform: scaleX(0);
  }

  :global(html.js) .vecina:global(.es-visible)::before {
    transform: scaleX(1);
    transition: transform 900ms var(--ease-out);
    transition-delay: var(--revelar-retardo, 0ms);
  }

  .vecina__enlace {
    position: relative;
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    gap: var(--paso-2);
    align-items: start;
    height: 100%;
    padding: var(--paso-2) 0;
    color: var(--carbon);
    text-decoration: none;
  }

  /* Línea de acento sobre el filete: entra por la izquierda y sale por la derecha. */
  .vecina__enlace::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: var(--acento-fuerte);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur-material) var(--ease-hoja);
  }

  .vecina__flecha {
    align-self: center;
    color: var(--acento-fuerte);
    opacity: 0;
    translate: -0.5rem 0;
    transition: opacity var(--dur-ui) ease,
      translate var(--dur-ui) var(--ease-out);
  }

  .vecina__icono {
    color: var(--tinta-2);
    transition: color var(--dur-ui) ease;
  }

  .vecina__icono :global(svg) {
    width: 2rem;
    height: 2rem;
  }

  .vecina__texto {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .vecina__nombre {
    font-size: var(--t-lista);
    line-height: 1.3;
    text-wrap: balance;
    transition: color var(--dur-ui) ease;
  }

  .vecina__sumario {
    font-size: var(--t-micro-2);
    line-height: 1.4;
    color: var(--tinta-2);
  }

  @media (hover: hover) and (pointer: fine) {
    .vecina__enlace:hover::before {
      transform: scaleX(1);
      transform-origin: left;
    }
    .vecina__enlace:hover .vecina__nombre,
    .vecina__enlace:hover .vecina__icono {
      color: var(--acento-fuerte);
    }
    .vecina__enlace:hover .vecina__flecha {
      opacity: 1;
      translate: 0 0;
    }
  }

  .vecina__enlace:focus-visible::before {
    transform: scaleX(1);
    transform-origin: left;
  }
  .vecina__enlace:focus-visible .vecina__nombre,
  .vecina__enlace:focus-visible .vecina__icono {
    color: var(--acento-fuerte);
  }
  .vecina__enlace:focus-visible .vecina__flecha {
    opacity: 1;
    translate: 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .vecina::before {
      transform: none;
      transition: none;
    }
    .vecina__enlace::before,
    .vecina__flecha,
    .vecina__nombre,
    .vecina__icono {
      transition-duration: 1ms;
    }
    .vecina__flecha {
      translate: 0 0;
    }
  }

  @media (max-width: 900px) {
    .listado__reticula {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 860px) {
    .ambitos__lista {
      grid-template-columns: minmax(0, 1fr);
    }
    .ambitos__item,
    .ambitos__item + .ambitos__item {
      border-left: 0;
      padding: var(--paso-3) 0;
    }
    .ambitos__item + .ambitos__item {
      border-top: 1px solid var(--filete);
    }
  }

  @media (max-width: 860px) {
    .vecinas__reticula {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .vecinas__reticula {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

---
import '../styles/global.css';
import Consentimiento from '../components/Consentimiento.astro';
import { centro } from '../data/contenido.js';

interface Props {
  titulo: string;
  descripcion: string;
}

const { titulo, descripcion } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Psychologist',
  name: centro.nombre,
  description: descripcion,
  url: canonica,
  image: new URL('/media/og.jpg', Astro.site).href,
  telephone: `+34 ${centro.telefono}`,
  email: centro.email,
  founder: { '@type': 'Person', name: centro.profesional },
  foundingDate: centro.desde,
  address: {
    '@type': 'PostalAddress',
    streetAddress: centro.direccion,
    postalCode: centro.cp,
    addressLocality: centro.localidad,
    addressRegion: centro.provincia,
    addressCountry: 'ES',
  },
  areaServed: `${centro.localidad}, ${centro.provincia}`,
  knowsLanguage: 'es-ES',
  identifier: centro.credenciales.map((c) => `${c.etiqueta} ${c.valor}`),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <meta name="theme-color" content="#F8F4EB" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={new URL('/media/og.jpg', Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="preload"
      href="/fonts/host-grotesk-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script is:inline>
      document.documentElement.classList.add('js');

      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

      setTimeout(function () {
        if (!window.__revelado) {
          document.documentElement.classList.remove('js');
        }
      }, 3000);
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script>
      import '../scripts/main.js';
    </script>
  </head>

  <body>
    <a class="salto-contenido" href="#contenido">Saltar al contenido</a>
    <slot />
    <Consentimiento />
  </body>
</html>

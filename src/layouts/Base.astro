---
import '../styles/global.css';
import Consentimiento from '../components/Consentimiento.astro';
import { alternas, i18n, idiomas } from '../i18n/index.js';

interface Props {
  titulo: string;
  descripcion: string;
  /** false: noindex y sin canonical ni alternativas (la 404). */
  indexable?: boolean;
}

const { titulo, descripcion, indexable = true } = Astro.props;
const { lang, t, d } = i18n(Astro);
const { centro } = d;
const canonica = new URL(Astro.url.pathname, Astro.site).href;

const ogLocale = { es: 'es_ES', en: 'en_GB' };
// Imagen para redes: cada idioma con su texto.
const imagenOg = new URL(lang === 'en' ? '/media/og-en.jpg' : '/media/og.jpg', Astro.site).href;
// Solo las páginas que existen en más de un idioma declaran alternativas. Se
// escriben con la misma barra final que el canonical (el build la añade).
const conBarra = Astro.url.pathname.length > 1 && Astro.url.pathname.endsWith('/');
const versiones = alternas(Astro.url.pathname);
const alternativas =
  versiones && Object.keys(versiones).length > 1
    ? Object.entries(versiones).map(([idioma, ruta]) => ({
        idioma,
        href: new URL(conBarra && !ruta.endsWith('/') ? `${ruta}/` : ruta, Astro.site).href,
      }))
    : [];

// Datos estructurados: la consulta y el sitio web. Los @id son fijos para que
// todas las páginas (y el BreadcrumbList de Portico) apunten a la misma entidad.
const portada = new URL('/', Astro.site).href;
// «Psychologist» no existe en schema.org: con ese tipo Google descartaba la
// entidad entera. MedicalBusiness es un LocalBusiness y sí cuenta como ficha.
const consulta = {
  '@type': 'MedicalBusiness',
  '@id': `${portada}#consulta`,
  name: centro.nombre,
  description: d.metas.inicio.descripcion(centro),
  url: portada,
  image: imagenOg,
  telephone: `+34 ${centro.telefono}`,
  email: centro.email,
  founder: {
    '@type': 'Person',
    '@id': `${portada}#profesional`,
    name: centro.profesional,
    jobTitle: lang === 'en' ? 'Health psychologist and family mediator' : 'Psicóloga sanitaria y mediadora familiar',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: centro.coordenadas.lat,
    longitude: centro.coordenadas.lon,
  },
  hasMap: centro.mapa,
  foundingDate: centro.desde,
  address: {
    '@type': 'PostalAddress',
    streetAddress: centro.direccion,
    postalCode: centro.cp,
    addressLocality: centro.localidad,
    addressRegion: centro.provincia,
    addressCountry: 'ES',
  },
  areaServed: `${centro.localidad}, ${centro.provincia}`,
  knowsLanguage: ['es-ES', 'en'],
  identifier: centro.credenciales.map((c) => `${c.etiqueta} ${c.valor}`),
};

const sitio = {
  '@type': 'WebSite',
  '@id': `${portada}#web`,
  name: centro.nombre,
  url: portada,
  inLanguage: idiomas,
  publisher: { '@id': consulta['@id'] },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [consulta, sitio],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {indexable ? <link rel="canonical" href={canonica} /> : <meta name="robots" content="noindex" />}
    {alternativas.map((a) => <link rel="alternate" hreflang={a.idioma} href={a.href} />)}
    {
      alternativas.length > 0 && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={alternativas.find((a) => a.idioma === 'es').href}
        />
      )
    }
    <meta name="theme-color" content="#F8F4EB" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale[lang]} />
    {
      alternativas
        .filter((a) => a.idioma !== lang)
        .map((a) => <meta property="og:locale:alternate" content={ogLocale[a.idioma]} />)
    }
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenOg} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenOg} />
    <meta property="og:image:alt" content={titulo} />
    <meta name="twitter:image:alt" content={titulo} />

    <link
      rel="preload"
      href="/fonts/host-grotesk-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <slot name="head" />

    <!-- Inline a propósito: con el CSS externo, Chrome a veces decide el opt-in
         antes de aplicarlo y se salta la transición. El resto va en global.css. -->
    <style is:inline>
      @media (prefers-reduced-motion: no-preference) {
        @view-transition {
          navigation: auto;
        }
      }
    </style>

    <script is:inline>
      document.documentElement.classList.add('js');

      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

      setTimeout(function () {
        if (!window.__revelado) {
          document.documentElement.classList.remove('js');
        }
      }, 3000);
    </script>

    <script is:inline>
      // Transiciones entre páginas (CSS en global.css): el título de un área
      // viaja de la lista a su ficha. Solo se nombran el título pulsado y el h1
      // de destino, y solo al avanzar; con nombres fijos, volver atrás los
      // cruzaría volando. Va aquí y no en main.js porque pagereveal salta antes
      // del primer pintado y el módulo llega tarde.
      (() => {
        const sinBarra = (ruta) => ruta.replace(/\/+$/, '') || '/';

        const nombrar = (el) => {
          el.style.viewTransitionName = 'area-titulo';
          // La caja ocupa toda la columna: ceñida al texto, la captura no se
          // deforma al viajar.
          el.style.width = 'fit-content';
        };

        const soltar = (el) => {
          el.style.viewTransitionName = '';
          el.style.width = '';
        };

        window.addEventListener('pageswap', async (e) => {
          if (!e.viewTransition || e.activation?.navigationType !== 'push') return;
          const destino = sinBarra(new URL(e.activation.entry.url).pathname);
          const titulo = [...document.querySelectorAll('[data-titulo-viaja]')].find(
            (el) => sinBarra(new URL(el.closest('a').href).pathname) === destino
          );
          if (!titulo) return;
          // Por si el h1 de esta página conserva el nombre de la transición anterior.
          document.getElementById('area-titulo')?.style.removeProperty('view-transition-name');
          nombrar(titulo);
          try {
            await e.viewTransition.ready;
          } catch {}
          soltar(titulo);
        });

        window.addEventListener('pagereveal', async (e) => {
          if (!e.viewTransition) return;
          // Llega con el contenido visible (ver html.llega en global.css). Si
          // main.js ya corrió, el revelado está en marcha y no hay quien la quite.
          if (!window.__revelado) document.documentElement.classList.add('llega');
          if (window.navigation?.activation?.navigationType !== 'push') return;
          const titulo = document.getElementById('area-titulo');
          if (!titulo) return;
          // Sin revelado: el título llega ya en su sitio, no sube después.
          titulo.removeAttribute('data-revelar');
          nombrar(titulo);
          try {
            await e.viewTransition.finished;
          } catch {}
          soltar(titulo);
        });
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script>
      import '../scripts/main.js';
    </script>
  </head>

  <body>
    <a class="salto-contenido" href="#contenido">{t.saltar}</a>
    <!-- Justo tras el enlace de salto: es fijo y visual, pero con teclado debe
         estar al alcance sin recorrer toda la página. -->
    <Consentimiento />
    <slot />
  </body>
</html>
